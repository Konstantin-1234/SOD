// Назначение:
//   Срабатывает после успешной записи объекта. Реализует бизнес-логику
//   запроса переноса срока: если запрос ещё не создавался (реквизит
//   аск_ЗапросПереносаСрока ложь), анализирует роли текущего пользователя
//   и автора процесса относительно проекта и создаёт ознакомительные
//   задачи для соответствующих ролей.
//
//   Роли:
//     ДУП — Директор управления проектом.
//     РП  — Руководитель проекта.
//
// Логика принятия решения (кто кого ознакомляет):
//
//   ┌─────────────────┬──────────────────┬────────────────────────────┐
//   │ Текущий польз-ль │ Автор (инициатор)│     Создаётся задача для   │
//   ├─────────────────┼──────────────────┼────────────────────────────┤
//   │ ДУП              │ не важно          │ ничего                     │
//   │ РП               │ НЕ ДУП            │ только ДУП                 │
//   │ РП               │ ДУП               │ ничего                     │
//   │ ни ДУП, ни РП    │ ДУП               │ ничего                     │
//   │ ни ДУП, ни РП    │ РП                │ только ДУП                 │
//   │ ни ДУП, ни РП    │ ни ДУП, ни РП     │ ДУП и РП                   │
//   └─────────────────┴──────────────────┴────────────────────────────┘
//
//   Смысл: ДУП всегда «в курсе» по умолчанию (либо сам действует,
//   либо автор — ДУП). РП информирует ДУП, если автор не ДУП.
//   Если действует третье лицо — информируются обе роли.
//
// Параметры:
//   Отказ — признак отказа от записи. Если на этапе &Перед был
//           установлен Отказ = Истина, обработчик сразу выходит.
//
// Используемые реквизиты текущего объекта:
//   - Проект                 — проект, к которому привязан объект
//   - ИнициаторПроцесса       — автор (инициатор) процесса
//   - аск_ЗапросПереносаСрока — Булево, флаг «задача уже создана».
//                                Истина — запрос уже обработан, повторно
//                                задачи не создаются.
// ****************************************************************************
&После("ПриЗаписи")
Процедура аск_сод_ПриЗаписи(Отказ)
	
	// Если запись была отменена на этапе «перед записью» — выходим
	Если отказ тогда
		Возврат;
	КонецЕсли; 
	
	// Если флаг уже взведён — задача была создана ранее, повторно не создаём.
	Если не ЭтотОбъект.аск_ЗапросПереносаСрока и Сотрудники.ОсновнойСотрудникПользователя() <> Справочники.сотрудники.ПустаяСсылка()
		и ЭтотОбъект.ВидВопроса = Перечисления.ВидыВопросовВыполненияЗадач.ПереносСрока и не ЭтотОбъект.ПометкаУдаления тогда
		
		// ----- Шаг 1: получаем исходные данные -----		
		// Инициализируем переменные для основных полных ролей.
		// Будут заполнены внутри функций ОпределитьДУП / ОпределитьРП
		// через передачу параметра по ссылке.
		// В рамках одного проекта роль одна — перезапись в цикле не критична.
		ОсновнаяРольДУП = Справочники.ПолныеРоли.пустаяСсылка();
		ОсновнаяРольРП  = Справочники.ПолныеРоли.пустаяСсылка();
		
		//ТекПользователь = Пользователи.АвторизованныйПользователь();
		ТекПользователь  = Сотрудники.ОсновнойСотрудникПользователя();
		Автор			 = ЭтотОбъект.ИнициаторПроцесса;
		
		// ----- Шаг 2: определяем составы ролей ДУП и РП для проекта -----
		// Функции возвращают массив исполнителей и через параметр —
		// ссылку на полную роль (последнюю в выборке — роль одна,
		// так что без разницы, первая или последняя)
		МассивДУП = ОпределитьДУП(ЭтотОбъект.Проект, ОсновнаяРольДУП);
		МассивРП  = ОпределитьРП(ЭтотОбъект.Проект, ОсновнаяРольРП);
		
		// ----- Шаг 3: проверяем принадлежность текущего пользователя к ролям -----
		ТекПользовательДУП = (МассивДУП.Найти(ТекПользователь) <> Неопределено);
		ТекПользовательРП  = (МассивРП.Найти(ТекПользователь)  <> Неопределено);
		
		// ----- Шаг 4: проверяем принадлежность автора (инициатора) к ролям -----
		АвторДУП = (МассивДУП.Найти(Автор) <> Неопределено);
		АвторРП  = (МассивРП.Найти(Автор)  <> Неопределено);
		
	// ----- Шаг 5: дерево решений -----	
		// Ситуация 1: текущий пользователь — ДУП.
		// Директор управления проектом сам в курсе, дополнительные задачи не нужны.
		Если ТекПользовательДУП тогда
			//Ничего не делаем
		
			// Ситуация 2: текущий пользователь — РП (руководитель проекта).
			// Если автор — НЕ ДУП, значит ДУП нужно проинформировать.
			// Создаём задачу только для ДУП.
		ИначеЕсли ТекПользовательРП  тогда
			Если не АвторДУП тогда
				СоздатьОзнакомительнуюЗадачу(Истина, ОсновнаяРольДУП, ОсновнаяРольРП);
			КонецЕсли;
			
			// Ситуация 3: текущий пользователь — ни ДУП, ни РП (третье лицо).
		Иначе
			// 3а: автор — ДУП → ДУП уже в курсе, ничего не делаем
			Если АвторДУП тогда
				//Ничего не делаем
				
				// 3б: автор — РП (но не ДУП) → информируем только ДУП
			ИначеЕсли АвторРП тогда
				СоздатьОзнакомительнуюЗадачу(Истина, ОсновнаяРольДУП, ОсновнаяРольРП);
				
				// 3в: автор — ни ДУП, ни РП → информируем обе роли
			Иначе
				СоздатьОзнакомительнуюЗадачу(Ложь, ОсновнаяРольДУП, ОсновнаяРольРП);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры  

Функция НайтиРольПоГуид(ГуидСтрока)

    УникальныйИд = Новый УникальныйИдентификатор(ГуидСтрока);

    Возврат Справочники.РолиИсполнителей.ПолучитьСсылку(УникальныйИд);

КонецФункции

// Назначение:
//   Определяет состав роли «ДУП» (Директор управления проектом)
//   для указанного проекта.
//
// Алгоритм:
//   1. По жёстко заданному GUID находит эталонную роль ДУП в справочнике
//      РолиИсполнителей.
//   2. Запросом находит все ПолныеРоли, у которых Владелец = эталонная роль
//      и ОсновнойОбъектАдресации = переданный Проект.
//      (Практически для одного проекта роль одна, но запрос написан
//       на общий случай.)
//   3. Через ЛЕВОЕ СОЕДИНЕНИЕ с регистром ИсполнителиРолей получает
//      всех исполнителей по найденным полным ролям.
//
// Параметры:
//   Проект            — проект, для которого ищутся полные роли ДУП
//   ОсновнаяРольДУП   — (передаётся по ссылке) заполняется ссылкой на
//                        полную роль ДУП. Если ролей несколько —
//                        сохраняется последняя (роль одна, не критично).
//
// Возвращаемое значение:
//   Массив — список исполнителей (Пользователи), входящих в роль ДУП
//            для данного проекта.
//
// Особенности:
//   - GUID зашит в коде. При переносе между базами потребуется
//     актуализация.
//   - ЛЕВОЕ СОЕДИНЕНИЕ: если у полной роли нет исполнителей в регистре,
//     в массив попадёт Неопределено (NULL). На логику это не влияет:
//     .Найти(Пользователь) для Неопределено никогда не даст совпадения
//     с реальным пользователем, ошибки не будет.
// ****************************************************************************
Функция ОпределитьДУП(Проект,ОсновнаяРольДУП)
	
	МассивДУП = Новый массив;                               
	
	 // Эталонная роль «ДУП» в справочнике РолиИсполнителей.
	РольДУП = НайтиРольПоГуид("6ebd51ab-6fc5-11f1-9409-b47af136901b"); // ДУП

		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПолныеРоли.Ссылка КАК ПолнаяРоль
			|ПОМЕСТИТЬ ВТ_ПолнаяРоль
			|ИЗ
			|	Справочник.ПолныеРоли КАК ПолныеРоли
			|ГДЕ
			|	ПолныеРоли.Владелец = &РольДУП
			|	И ПолныеРоли.ОсновнойОбъектАдресации = &Проект
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ 
			|	ИсполнителиРолей.РольИсполнителя КАК РольИсполнителя,
			|	ИсполнителиРолей.Исполнитель КАК Исполнитель
			|ИЗ
			|	ВТ_ПолнаяРоль КАК ВТ_ПолнаяРоль
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиРолей КАК ИсполнителиРолей
			|		ПО ВТ_ПолнаяРоль.ПолнаяРоль = ИсполнителиРолей.РольИсполнителя";
		
		Запрос.УстановитьПараметр("Проект", Проект);
		Запрос.УстановитьПараметр("РольДУП", РольДУП);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			МассивДУП.добавить(Выборка.Исполнитель); 
			// Роль для проекта одна, поэтому первая/последняя — без разницы
			ОсновнаяРольДУП = Выборка.РольИсполнителя;
		КонецЦикла;
		
	возврат МассивДУП
КонецФункции  

// ФУНКЦИЯ: ОпределитьРП
//
// Назначение:
//   То же, что ОпределитьДУП, но для роли «РП» (Руководитель проекта).
//
// Алгоритм:
//   Аналогичен ОпределитьДУП — поиск эталонной роли РП по GUID,
//   затем получение полных ролей для проекта и их исполнителей
//   через регистр ИсполнителиРолей.
//
// Параметры:
//   Проект           — проект, для которого ищутся полные роли РП
//   ОсновнаяРольРП   — (передаётся по ссылке) заполняется ссылкой на
//                       полную роль РП
//
// Возвращаемое значение:
//   Массив — список исполнителей (Пользователи), входящих в роль РП
//            для данного проекта
//
// Особенности:
//   - Те же, что у ОпределитьДУП: GUID зашит, ЛЕВОЕ СОЕДИНЕНИЕ может
//     дать NULL в массиве (на логику не влияет).
// ****************************************************************************
Функция ОпределитьРП(Проект,ОсновнаяРольРП)
	
	МассивРП =  Новый Массив; 
	 // Эталонная роль «РП» в справочнике РолиИсполнителей.
	РольРП = НайтиРольПоГуид("796604ab-7b54-11f1-9409-b47af136901b"); // РП
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПолныеРоли.Ссылка КАК ПолнаяРоль
			|ПОМЕСТИТЬ ВТ_ПолнаяРоль
			|ИЗ
			|	Справочник.ПолныеРоли КАК ПолныеРоли
			|ГДЕ
			|	ПолныеРоли.Владелец = &РольРП
			|	И ПолныеРоли.ОсновнойОбъектАдресации = &Проект
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ 
			|	ИсполнителиРолей.РольИсполнителя КАК РольИсполнителя,
			|	ИсполнителиРолей.Исполнитель КАК Исполнитель
			|ИЗ
			|	ВТ_ПолнаяРоль КАК ВТ_ПолнаяРоль
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсполнителиРолей КАК ИсполнителиРолей
			|		ПО ВТ_ПолнаяРоль.ПолнаяРоль = ИсполнителиРолей.РольИсполнителя";
		
		Запрос.УстановитьПараметр("Проект", Проект);
		Запрос.УстановитьПараметр("РольРП", РольРП);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			МассивРП.Добавить(Выборка.Исполнитель);
			ОсновнаяРольРП = Выборка.РольИсполнителя
		КонецЦикла;
			
	возврат МассивРП 
КонецФункции  

// ПРОЦЕДУРА: СоздатьОзнакомительнуюЗадачу
//
// Назначение:
//   Создаёт одну или две ознакомительные задачи для ролей ДУП и/или РП
//   в зависимости от флага ТолькоДУП.
//
// Параметры:
//   ТолькоДУП (Булево):
//     Истина  — создать задачу только для роли ДУП.
//     Ложь    — создать задачи и для ДУП, и для РП.
//   ОсновнаяРольДУП — полная роль ДУП (кому адресуется задача)
//   ОсновнаяРольРП  — полная роль РП  (кому адресуется задача)
//
// Особенности:
//   - - Флаг аск_ЗапросПереносаСрока устанавливается в Истина внутри
//     СоздатьДокументЗадачуПоРоли. При создании двух задач флаг
//     будет установлен дважды (оба раза в Истина) — без разницы.
// ****************************************************************************
Процедура СоздатьОзнакомительнуюЗадачу(ТолькоДУП,ОсновнаяРольДУП,ОсновнаяРольРП) 
 // Получаем элементы справочника полных ролей (вашими методами)
 
 // 1. Задача для ДУП (создается всегда)
	 Если ЗначениеЗаполнено(ОсновнаяРольДУП) Тогда
		 СоздатьДокументЗадачуПоРоли(ОсновнаяРольДУП);
	 КонецЕсли;
	 
	 // 2. Если НЕ ТолькоДУП — создаем вторую задачу для РП
	 Если НЕ ТолькоДУП Тогда
		 Если ЗначениеЗаполнено(ОсновнаяРольРП) Тогда
			 СоздатьДокументЗадачуПоРоли(ОсновнаяРольРП);
		 КонецЕсли;
	 КонецЕсли;
КонецПроцедуры     

// Назначение:
//   Программно создаёт новый документ «Задача» с типом «Ознакомление»
//   и адресует его указанной полной роли. После создания проводит документ
//   и взводит флаг аск_ЗапросПереносаСрока = Истина, чтобы при следующей
//   записи объекта не создавать дубликаты.
//
// Параметры:
//   РольИсполнителя — полная роль (СправочникСсылка.ПолныеРоли),
//                      которая будет указана как «Ознакомляемый» участник.
//   ТекстОписания   — строка для поля Описание задачи
//                      (например, «Ознакомиться (ДУП)»).
//
// Заполняемые поля задачи:
//   ┌─────────────────────┬──────────────────────────────────────┐
//   │ Поле                 │ Значение                             │
//   ├─────────────────────┼──────────────────────────────────────┤
//   │ Дата                 │ ТекущаяДатаСеанса()                  │
//   │ Создал               │ Пользователи.ТекущийПользователь()   │
//   │ Автор                │ Пользователи.ТекущийПользователь()   │
//   │ ВидЗадачи            │ Ознакомление                         │
//   │ Заголовок            │ "Ознакомиться"                       │
//   │ Описание             │ ТекстОписания (параметр)             │
//   │ Проект               │ ЭтотОбъект.Проект                    │
//   │ Приоритет            │ Обычный                              │
//   │ СостояниеЗадачи      │ ВРаботе                              │
//   │ ДатаСоздания         │ ТекущаяДатаСеанса()                  │
//   │ ДатаНачала           │ ТекущаяДатаСеанса()                  │
//   │ Срок                 │ Текущая дата + 3 дня (конец дня)     │
//   │ ТипПриложения        │ БезПриложений                        │
//   │ Участники (ТЧ)       │ 1 строка: Ознакомляемый = Роль       │
//   └─────────────────────┴──────────────────────────────────────┘
//
// Побочный эффект:
//   Устанавливает ЭтотОбъект.аск_ЗапросПереносаСрока = Истина.
//   При повторном вызове (для второй роли) флаг взводится ещё раз —
//   это допустимо, значение остаётся Истина.// ****************************************************************************
Процедура СоздатьДокументЗадачуПоРоли(РольИсполнителя)

	НовЗадача = Документы.Задача.СоздатьДокумент();
	
	// 1. Системные реквизиты
	НовЗадача.Дата   = ТекущаяДатаСеанса(); 
	НовЗадача.Создал = Пользователи.ТекущийПользователь(); 
	НовЗадача.Автор = Сотрудники.ОсновнойСотрудникПользователя(); 
	// 2. Вид задачи и заголовки
	// Реквизит ВидЗадачи ссылается на Справочник.ВидыЗадач
	НовЗадача.ВидЗадачи = Справочники.ВидыЗадач.Ознакомление; 
	НовЗадача.Заголовок = "Ознакомиться ";
	
	ТекстОписания                = ПолучитьТекстОписания();
	НовЗадача.Описание  		 = ТекстОписания;	
	НовоеОписаниеФорматированное = Новый ФорматированныйДокумент;
	НовоеОписаниеФорматированное.Добавить(ТекстОписания, Тип("ТекстФорматированногоДокумента"));
	НовЗадача.ОписаниеФорматированное = Новый ХранилищеЗначения(НовоеОписаниеФорматированное);

	
	// 4. Проект и приоритет
	НовЗадача.Проект    = ЭтотОбъект.Проект;
	НовЗадача.Приоритет = Справочники.ПриоритетыЗадач.Обычный;
	
	// 5. Состояние задачи
	НовЗадача.СостояниеЗадачи = Справочники.СостоянияЗадач.Новая;
	
	// 6. Даты и сроки
	НовЗадача.ДатаСоздания = ТекущаяДатаСеанса();
	//НовЗадача.ДатаНачала   = ТекущаяДатаСеанса();
	//НовЗадача.Срок         = КонецДня(ТекущаяДатаСеанса() + 86400 * 3); // например, +3 дня на ознакомление
	
	// 7. Дополнительные реквизиты
	НовЗадача.ТипПриложения = Перечисления.ТипыПриложенийЗадач.БезПриложений;   
	
	стрУчастники = НовЗадача.Участники.Добавить();
	стрУчастники.ВидУчастника  		   =  Справочники.ВидыУчастниковЗадач.Ознакомляемый;
	стрУчастники.Участник              =  РольИсполнителя;
	// Записываем и проводим (документ поддерживает проведение: "Проведен = Да")   
	НовЗадача.Записать(РежимЗаписиДокумента.Проведение); 
	
	//Не склиента запускаем, нужно выполнить клиентские обработки, нашел то что клиент на сервере делает, скопировал сюда
	БизнесПроцессыДляЗадачаи(НовЗадача);

	// Взводим флаг — задача создана, повторно не создаём
	ЭтотОбъект.аск_ЗапросПереносаСрока = Истина; 
КонецПроцедуры

Функция ПолучитьТекстОписания()  
	МероприятиеНавание = "";
	Если ЭтотОбъект.Предметы.Количество() <> 0 тогда
		МероприятиеНавание = ЭтотОбъект.Предметы[0].предмет;
	КонецЕсли;
	
	Текст = "По проекту " + ЭтотОбъект.Проект + " по задаче " + """" + ЭтотОбъект.ГлавнаяЗадача.Описание + """" + " в рамках совещания " +  ЭтотОбъект.Предметы[0].Предмет 
	+ " создан запрос на перенос срока выполнения задачи. Текущий срок: " + Формат(ЭтотОбъект.СрокИсполнения,"ДФ=dd.MM.yyyy") 
	+ ". Новый запрашиваемый срок: " + Формат(ЭтотОбъект.НовыйСрок,"ДФ=dd.MM.yyyy") +"." ;
    Возврат Текст;

КонецФункции    

//Запись в регистр очередь уведомлений и произошедшие события
Процедура БизнесПроцессыДляЗадачаи(НовЗадача)
	ПараметрыНаправленияНаИсполнение = РаботаСЗадачамиКлиентСервер.НовыйПараметрыНаправленияНаИсполнение();
	ПараметрыНаправленияНаИсполнение.Задача = НовЗадача.Ссылка;
	ПараметрыНаправленияНаИсполнение.ЭтоИнтерактивноеДействие = Истина;
	ПараметрыНаправленияНаИсполнение.ИдентификаторФормы = ""; 
	
	РезультатНаправленияНаИсполнение = РаботаСЗадачамиВызовСервера.НаправитьНаИсполнение(ПараметрыНаправленияНаИсполнение);	
	БизнесСобытияВызовСервера.ЗарегистрироватьСобытие(НовЗадача.Ссылка, Справочники.ВидыБизнесСобытий.НоваяЗадача); 
КонецПроцедуры