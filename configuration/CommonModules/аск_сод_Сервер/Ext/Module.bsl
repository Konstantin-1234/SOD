//В данный момент отключили использование, но может пригодиться в будущем для доработок СОД 
//Находим группу "СОД"
Функция АСК_ПроверяемНаПринадлежностьСОД(ВидДокумента) Экспорт 
	ЗащитаИтерации = 20;  // Разумный лимит глубины
	РодительВИтерации = ВидДокумента.Родитель;
	
	// Защита от пустой ссылки на старте
	Если РодительВИтерации = Справочники.ВидыДокументов.ПустаяСсылка() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Пока ЗащитаИтерации > 0 Цикл
		ТекущийРодитель = РодительВИтерации.Родитель;
		Если ТекущийРодитель = Справочники.ВидыДокументов.ПустаяСсылка() Тогда
			Прервать;  // Дошли до корня
		КонецЕсли;
		РодительВИтерации = ТекущийРодитель;
		ЗащитаИтерации = ЗащитаИтерации - 1;
	КонецЦикла;
	
	Если ЗащитаИтерации = 0 Тогда
		// Не дошли до корня — глубина превышает лимит
		Возврат Ложь;
	КонецЕсли;
	
	// Сравнение UUID напрямую, без Строка()
	Возврат РодительВИтерации.УникальныйИдентификатор() = Новый УникальныйИдентификатор("96440c9f-7b63-11f1-9409-b47af136901b");	
КонецФункции
