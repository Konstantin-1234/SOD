
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьДоступностьКоманд();
КонецПроцедуры
//-------------------------------------------

&НаСервере
Процедура УстановитьДоступностьКоманд()
    Элементы.ФормаВыполнитьЗагрузкуСтруктурыКаталокаВБазу.Доступность = НЕ СправочникПустойНаСервере();
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.ПутьККаталогу)
	 ИЛИ НЕ ЗначениеЗаполнено(ЭтаФорма.Разделитель)
	Тогда
		 Элементы.ФормаВыполнитьЗагрузкуСтруктурыКаталокаВБазу.Доступность = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СправочникПустойНаСервере()
	Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |	СтруктураКаталога.Ссылка КАК Ссылка,
        |	СтруктураКаталога.РазделительЗагрузки КАК РазделительЗагрузки
        |ИЗ
        |	Справочник.аск_сод_СтруктураКаталогаЗагрузки КАК СтруктураКаталога
        |ГДЕ
        |	НЕ СтруктураКаталога.ПометкаУдаления
        |	И СтруктураКаталога.РазделительЗагрузки = &РазделительЗагрузки";
	Запрос.УстановитьПараметр("РазделительЗагрузки",ЭтаФорма.Разделитель);
    Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции

&НаКлиенте
Процедура ПутьККаталогуПриИзменении(Элемент)
	УстановитьДоступностьКоманд();
КонецПроцедуры

&НаКлиенте
Процедура РазделительПриИзменении(Элемент)
	УстановитьДоступностьКоманд();
КонецПроцедуры
//----------------------------------------

// Обработчик события начала выбора для поля "Каталог проекта".
// Открывает диалог выбора каталога и устанавливает выбранный путь в реквизит формы.
//
// Параметры:
//  Элемент - ПолеФормы - поле формы, для которого возникло событие;
//  ДанныеВыбора - ДанныеВыбораИзПоляВвода - данные выбора, сформированные полем ввода;
//  ВыборДобавлением - Булево - признак того, что выбор был осуществлен путем добавления новой строки;
//  СтандартнаяОбработка - Булево - признак необходимости выполнения стандартной обработки события.
//
&НаКлиенте
Процедура ПутьККаталогуНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
    ДиалогВыбора.Заголовок = "Выберите каталог проекта";
	Если ЗначениеЗаполнено(ЭтаФорма.ПутьККаталогу) Тогда
		ДиалогВыбора.Каталог = ЭтаФорма.ПутьККаталогу;
	КонецЕсли;
	
	ЭтаФорма.ПутьККаталогу = ДиалогВыбора.Каталог;
	Если ДиалогВыбора.Выбрать() Тогда
		ЭтаФорма.ПутьККаталогу = ДиалогВыбора.Каталог;
	КонецЕсли;
	
	УстановитьДоступностьКоманд();
КонецПроцедуры
//----------------------------------------

&НаКлиенте
Процедура ВыполнитьЗагрузкуСтруктурыКаталокаВБазу(Команда)
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.ПутьККаталогу)
	 ИЛИ НЕ ЗначениеЗаполнено(ЭтаФорма.Разделитель)
	Тогда
	    Сообщить("Укажите ПутьККаталогу и Разделитель");
		Возврат;
	КонецЕсли;
	 
	ПоказатьВопрос(Новый ОписаниеОповещения("ПрочитатьСтруктуруКаталогаВопросЗавершение", ЭтотОбъект),"Загрузить структуру каталога в базу?",РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
КонецПроцедуры 
	
&НаКлиенте
Процедура ПрочитатьСтруктуруКаталогаВопросЗавершение(Результат, ДополнительныеПараметры) Экспорт
    Если Результат = КодВозвратаДиалога.Да Тогда
		НачатьОбходКаталога();
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачатьОбходКаталога()
	Обход = Новый Структура;
    Обход.Вставить("МассивПапок",  Новый Массив);
    Обход.Вставить("ОчередьПапок", Новый Массив);
    Обход.Вставить("КорневойПуть", ПутьККаталогу);
    
    ОбойтиСледующуюПапку(Обход, ПутьККаталогу, Неопределено, "");
КонецПроцедуры

&НаСервере
Функция ЕстьПодпапкиВКаталоге(Знач ПутьКПапке)
    НайденныеФайлы = НайтиФайлы(ПутьКПапке, "*", Ложь);
    Для Каждого Файл Из НайденныеФайлы Цикл
        Если Файл.ЭтоКаталог() Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

&НаКлиенте
Процедура ОбойтиСледующуюПапку(КонтекстОбхода, ТекущийПуть, ПутьРодителя, ИмяТекущейПапки)
    ДопПараметры = Новый Структура;
    ДопПараметры.Вставить("КонтекстОбхода",КонтекстОбхода);
    ДопПараметры.Вставить("ТекущийПуть",ТекущийПуть);
    ДопПараметры.Вставить("ПутьРодителя",ПутьРодителя);
    ДопПараметры.Вставить("ИмяТекущейПапки",ИмяТекущейПапки);
    
	КаталогФайл = Новый Файл(ТекущийПуть);
    
    НачатьПоискФайлов(
        Новый ОписаниеОповещения("ОбходПапкиЗавершён", ЭтотОбъект, ДопПараметры),
        ТекущийПуть, 
        "*"); 
КонецПроцедуры 
	
&НаКлиенте
Процедура ОбходПапкиЗавершён(НайденныеФайлы, ДополнительныеПараметры) Экспорт
    КонтекстОбхода = ДополнительныеПараметры.КонтекстОбхода;
    ТекущийПуть = ДополнительныеПараметры.ТекущийПуть;
    ПутьРодителя = ДополнительныеПараметры.ПутьРодителя;
    ИмяТекущейПапки = ДополнительныеПараметры.ИмяТекущейПапки;
    
    ПодпапкиТекущего = Новый Массив;
    Для Каждого Файл Из НайденныеФайлы Цикл
        Если Файл.ЭтоКаталог() Тогда
            ПодпапкиТекущего.Добавить(Новый Структура("Путь,Имя", Файл.ПолноеИмя, Файл.Имя));
        КонецЕсли;
    КонецЦикла;
    
    Если ПутьРодителя <> Неопределено Тогда
        ОписаниеПапки = Новый Структура;
        ОписаниеПапки.Вставить("Путь",         ТекущийПуть);
        ОписаниеПапки.Вставить("ИмяПапки",     ИмяТекущейПапки);
        ОписаниеПапки.Вставить("ПутьРодителя", ПутьРодителя);
        ОписаниеПапки.Вставить("ЕстьПодпапки", ПодпапкиТекущего.Количество() > 0);
        КонтекстОбхода.МассивПапок.Добавить(ОписаниеПапки);
	КонецЕсли;
	
	Для Каждого Подпапка Из ПодпапкиТекущего Цикл
        ЭлементОчереди = Новый Структура;
        ЭлементОчереди.Вставить("Путь",         Подпапка.Путь);
        ЭлементОчереди.Вставить("ПутьРодителя", ТекущийПуть);
        ЭлементОчереди.Вставить("ИмяПапки",     Подпапка.Имя);
        КонтекстОбхода.ОчередьПапок.Добавить(ЭлементОчереди);
    КонецЦикла;
    
    
    ОбработатьОчередьПапок(КонтекстОбхода);
КонецПроцедуры 

&НаКлиенте
Процедура ОбработатьОчередьПапок(КонтекстОбхода)
    Если КонтекстОбхода.ОчередьПапок.Количество() > 0 Тогда
        
        СледующийЭлемент = КонтекстОбхода.ОчередьПапок[0];
        КонтекстОбхода.ОчередьПапок.Удалить(0);
        
        ОбойтиСледующуюПапку(
            КонтекстОбхода,
            СледующийЭлемент.Путь,
            СледующийЭлемент.ПутьРодителя,
            СледующийЭлемент.ИмяПапки);
    Иначе
        ЗавершитьОбходКаталога(КонтекстОбхода);
    КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура ЗавершитьОбходКаталога(КонтекстОбхода)
    Если КонтекстОбхода.МассивПапок.Количество() = 0 Тогда
        ПоказатьПредупреждение(, "В указанном каталоге не найдено вложенных папок.");
        Возврат;
    КонецЕсли;
    
    СоздатьЭлементыСправочникаНаСервере(КонтекстОбхода.МассивПапок);
    
    
    ПоказатьОповещениеПользователя(
        "Готово",
        ,
        "Структура каталога успешно прочитана. Создано папок: "
            + КонтекстОбхода.МассивПапок.Количество(),
        БиблиотекаКартинок.Информация32);
    
	//Элементы.Список.Обновить();
    УстановитьДоступностьКоманд();
КонецПроцедуры 


&НаСервере
Процедура СоздатьЭлементыСправочникаНаСервере(МассивПапок)
    
    СловарьПутьСсылка = Новый Соответствие;
    СловарьПутьСсылка.Вставить(ПутьККаталогу, Справочники.аск_сод_СтруктураКаталогаЗагрузки.ПустаяСсылка());
    
    НачатьТранзакцию();
    Попытка
        
        Для Каждого ОписаниеПапки Из МассивПапок Цикл
            
            РодительСсылка = СловарьПутьСсылка[ОписаниеПапки.ПутьРодителя];
 			НовыйЭлемент = Справочники.аск_сод_СтруктураКаталогаЗагрузки.СоздатьЭлемент();
           Если РодительСсылка <> Неопределено Тогда
                НовыйЭлемент.Родитель = РодительСсылка;
			КонецЕсли;
			
            НовыйЭлемент.Наименование = ОписаниеПапки.ИмяПапки;
            НовыйЭлемент.РазделительЗагрузки = ЭтаФорма.Разделитель;
            НовыйЭлемент.ПолныйПутьККаталогу = 
				?(ЗначениеЗаполнено(НовыйЭлемент.Родитель.ПолныйПутьККаталогу),НовыйЭлемент.Родитель.ПолныйПутьККаталогу + "\","")
				+НовыйЭлемент.Наименование
				;

			Если ОписаниеПапки.ЕстьПодпапки Тогда
                НовыйЭлемент.СпособЗагрузкиИзКаталога =
                    Перечисления.СпособыЗагрузкиИзКаталога.СмотретьДалее;
            Иначе
                НовыйЭлемент.СпособЗагрузкиИзКаталога =
                    Перечисления.СпособыЗагрузкиИзКаталога.СоздатьДокументИЗагрузитьФайлы;
            КонецЕсли;
            
            НоваяСтрокаТЧ = НовыйЭлемент.ПредставленияКаталога.Добавить();
            НоваяСтрокаТЧ.ПредставлениеКаталога = ОписаниеПапки.ИмяПапки;
            
            НовыйЭлемент.Записать(); 
			
			СловарьПутьСсылка.Вставить(ОписаниеПапки.Путь, НовыйЭлемент.Ссылка);
            
        КонецЦикла;
        
        ЗафиксироватьТранзакцию();
        
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение "Ошибка при создании структуры каталога: " + ОписаниеОшибки();
    КонецПопытки;
    
КонецПроцедуры



