
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьДоступностьКоманд();
КонецПроцедуры

//-------------------------------------------
&НаСервере
Процедура УстановитьДоступностьКоманд()
    Элементы.ФормаПрочитатьСтруктуруКаталога.Доступность = СправочникПустойНаСервере();
КонецПроцедуры

&НаСервере
Функция СправочникПустойНаСервере()
    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |    СтруктураКаталога.Ссылка
        |ИЗ
        |    Справочник.аск_сод_СтруктураКаталогаЗагрузки КАК СтруктураКаталога
        |ГДЕ
        |    НЕ СтруктураКаталога.ПометкаУдаления";
    Возврат Запрос.Выполнить().Пустой();
КонецФункции

//-------------------------------------------
&НаКлиенте
Процедура ЗагрузитьСтруктуруКаталога(Команда)
	ПараметрыФормы = Новый Структура("", );
	ОткрытьФорму("Справочник.аск_сод_СтруктураКаталогаЗагрузки.Форма.ЗагрузкаСтруктуруКаталогаСДиска", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры
//-------------------------------------------

&НаКлиенте
Процедура ПутьККаталогуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    
    ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
    ДиалогВыбора.Заголовок = "Выберите папку для загрузки";
    ДиалогВыбора.МножественныйВыбор = Ложь;
    
    Если НЕ ПустаяСтрока(ПутьККаталогу) Тогда
        ДиалогВыбора.Каталог = ПутьККаталогу;
    КонецЕсли;
    
    ДиалогВыбора.Показать(Новый ОписаниеОповещения(
        "ПутьККаталогуВыбранЗавершение", ЭтотОбъект));
КонецПроцедуры

&НаКлиенте
Процедура ПутьККаталогуВыбранЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
    Если ВыбранныеФайлы = Неопределено Тогда
        Возврат;
    КонецЕсли;
    ПутьККаталогу = ВыбранныеФайлы[0];
    ОбработатьВыбранныйКаталогНаСервере(ПутьККаталогу);
КонецПроцедуры 

&НаСервере
Процедура ОбработатьВыбранныйКаталогНаСервере(Знач ПутьКПапке)
    
    ТекущаяСсылка = Элементы.Список.ТекущаяСтрока;
    Если ТекущаяСсылка = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ЕстьПодпапки = ЕстьПодпапкиВКаталоге(ПутьКПапке);
    
    ОбъектСправочника = ТекущаяСсылка.ПолучитьОбъект();
    
    Если ЕстьПодпапки Тогда
        ОбъектСправочника.СпособЗагрузкиИзКаталога =
            Перечисления.СпособыЗагрузкиИзКаталога.СмотретьДалее;
    Иначе
        ОбъектСправочника.СпособЗагрузкиИзКаталога =
            Перечисления.СпособыЗагрузкиИзКаталога.СоздатьДокументИЗагрузитьФайлы;
    КонецЕсли;
    
    ИмяПапки = СтрРазделить(СтрЗаменить(ПутьКПапке, "/", "\"), "\", Ложь);
    ИмяПапки = ИмяПапки[ИмяПапки.ВГраница()];
    
    СтрокаТЧ = ОбъектСправочника.ПредставленияКаталога.Найти(ИмяПапки, "ПредставлениеКаталога");
    Если СтрокаТЧ = Неопределено Тогда
        НоваяСтрока = ОбъектСправочника.ПредставленияКаталога.Добавить();
        НоваяСтрока.ПредставлениеКаталога = ИмяПапки;
	КонецЕсли; 
	
	ОбъектСправочника.Записать();
    
КонецПроцедуры
//-------------------------------------------

&НаКлиенте
Процедура ПрочитатьСтруктуруКаталога(Команда) 
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ПрочитатьСтруктуруКаталогаВопросЗавершение", ЭтотОбъект),,РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
		
КонецПроцедуры 
	
&НаКлиенте
Процедура ПрочитатьСтруктуруКаталогаВопросЗавершение(Результат, ДополнительныеПараметры) Экспорт
    Если Результат = КодВозвратаДиалога.Да Тогда
        НачатьОбходКаталога();
    КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура НачатьОбходКаталога()
	
	Обход = Новый Структура;
    Обход.Вставить("МассивПапок",  Новый Массив);
    Обход.Вставить("ОчередьПапок", Новый Массив);
    Обход.Вставить("КорневойПуть", ПутьККаталогу);
    
    ОбойтиСледующуюПапку(Обход, ПутьККаталогу, Неопределено, "");
    
КонецПроцедуры



&НаСервере
Функция ЕстьПодпапкиВКаталоге(Знач ПутьКПапке)
    НайденныеФайлы = НайтиФайлы(ПутьКПапке, "*", Ложь);
    Для Каждого Файл Из НайденныеФайлы Цикл
        Если Файл.ЭтоКаталог() Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

&НаКлиенте
Процедура ОбойтиСледующуюПапку(КонтекстОбхода, ТекущийПуть, ПутьРодителя, ИмяТекущейПапки)
    
    ДопПараметры = Новый Структура;
    ДопПараметры.Вставить("КонтекстОбхода",КонтекстОбхода);
    ДопПараметры.Вставить("ТекущийПуть",ТекущийПуть);
    ДопПараметры.Вставить("ПутьРодителя",ПутьРодителя);
    ДопПараметры.Вставить("ИмяТекущейПапки",ИмяТекущейПапки);
    
	КаталогФайл = Новый Файл(ТекущийПуть);
    
     НачатьПоискФайлов(
        Новый ОписаниеОповещения("ОбходПапкиЗавершён", ЭтотОбъект, ДопПараметры),
        ТекущийПуть, 
        "*"); 
КонецПроцедуры 
	
	
&НаКлиенте
Процедура ОбходПапкиЗавершён(НайденныеФайлы, ДополнительныеПараметры) Экспорт
    
    КонтекстОбхода = ДополнительныеПараметры.КонтекстОбхода;
    ТекущийПуть = ДополнительныеПараметры.ТекущийПуть;
    ПутьРодителя = ДополнительныеПараметры.ПутьРодителя;
    ИмяТекущейПапки = ДополнительныеПараметры.ИмяТекущейПапки;
    
    ПодпапкиТекущего = Новый Массив;
    Для Каждого Файл Из НайденныеФайлы Цикл
        Если Файл.ЭтоКаталог() Тогда
            ПодпапкиТекущего.Добавить(Новый Структура("Путь,Имя", Файл.ПолноеИмя, Файл.Имя));
        КонецЕсли;
    КонецЦикла;
    
    Если ПутьРодителя <> Неопределено Тогда
        ОписаниеПапки = Новый Структура;
        ОписаниеПапки.Вставить("Путь",         ТекущийПуть);
        ОписаниеПапки.Вставить("ИмяПапки",     ИмяТекущейПапки);
        ОписаниеПапки.Вставить("ПутьРодителя", ПутьРодителя);
        ОписаниеПапки.Вставить("ЕстьПодпапки", ПодпапкиТекущего.Количество() > 0);
        КонтекстОбхода.МассивПапок.Добавить(ОписаниеПапки);
	КонецЕсли;
	
	Для Каждого Подпапка Из ПодпапкиТекущего Цикл
        ЭлементОчереди = Новый Структура;
        ЭлементОчереди.Вставить("Путь",         Подпапка.Путь);
        ЭлементОчереди.Вставить("ПутьРодителя", ТекущийПуть);
        ЭлементОчереди.Вставить("ИмяПапки",     Подпапка.Имя);
        КонтекстОбхода.ОчередьПапок.Добавить(ЭлементОчереди);
    КонецЦикла;
    
    
    ОбработатьОчередьПапок(КонтекстОбхода);
    
КонецПроцедуры 

&НаКлиенте
Процедура ОбработатьОчередьПапок(КонтекстОбхода)
    
    Если КонтекстОбхода.ОчередьПапок.Количество() > 0 Тогда
        
        СледующийЭлемент = КонтекстОбхода.ОчередьПапок[0];
        КонтекстОбхода.ОчередьПапок.Удалить(0);
        
        ОбойтиСледующуюПапку(
            КонтекстОбхода,
            СледующийЭлемент.Путь,
            СледующийЭлемент.ПутьРодителя,
            СледующийЭлемент.ИмяПапки);
    Иначе
        ЗавершитьОбходКаталога(КонтекстОбхода);
    КонецЕсли;
    
КонецПроцедуры 

&НаКлиенте
Процедура ЗавершитьОбходКаталога(КонтекстОбхода)
    
    Если КонтекстОбхода.МассивПапок.Количество() = 0 Тогда
        ПоказатьПредупреждение(, "В указанном каталоге не найдено вложенных папок.");
        Возврат;
    КонецЕсли;
    
    СоздатьЭлементыСправочникаНаСервере(КонтекстОбхода.МассивПапок);
    
    
    ПоказатьОповещениеПользователя(
        "Готово",
        ,
        "Структура каталога успешно прочитана. Создано папок: "
            + КонтекстОбхода.МассивПапок.Количество(),
        БиблиотекаКартинок.Информация32);
    
    Элементы.Список.Обновить();
    УстановитьДоступностьКомандНаКлиенте();
	
КонецПроцедуры 


&НаСервере
Процедура СоздатьЭлементыСправочникаНаСервере(МассивПапок)
    
    СловарьПутьСсылка = Новый Соответствие;
    СловарьПутьСсылка.Вставить(ПутьККаталогу, Справочники.аск_сод_СтруктураКаталогаЗагрузки.ПустаяСсылка());
    
    НачатьТранзакцию();
    Попытка
        
        Для Каждого ОписаниеПапки Из МассивПапок Цикл
            
            НовыйЭлемент = Справочники.аск_сод_СтруктураКаталогаЗагрузки.СоздатьЭлемент();
            НовыйЭлемент.Наименование = ОписаниеПапки.ИмяПапки;
            
            РодительСсылка = СловарьПутьСсылка[ОписаниеПапки.ПутьРодителя];
            Если РодительСсылка <> Неопределено Тогда
                НовыйЭлемент.Родитель = РодительСсылка;
            КонецЕсли;
            
            Если ОписаниеПапки.ЕстьПодпапки Тогда
                НовыйЭлемент.СпособЗагрузкиИзКаталога =
                    Перечисления.СпособыЗагрузкиИзКаталога.СмотретьДалее;
            Иначе
                НовыйЭлемент.СпособЗагрузкиИзКаталога =
                    Перечисления.СпособыЗагрузкиИзКаталога.СоздатьДокументИЗагрузитьФайлы;
            КонецЕсли;
            
            НоваяСтрокаТЧ = НовыйЭлемент.ПредставленияКаталога.Добавить();
            НоваяСтрокаТЧ.ПредставлениеКаталога = ОписаниеПапки.ИмяПапки;
            
            НовыйЭлемент.Записать(); 
			
			СловарьПутьСсылка.Вставить(ОписаниеПапки.Путь, НовыйЭлемент.Ссылка);
            
        КонецЦикла;
        
        ЗафиксироватьТранзакцию();
        
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение "Ошибка при создании структуры каталога: " + ОписаниеОшибки();
    КонецПопытки;
    
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКомандНаКлиенте()
    УстановитьДоступностьКоманд();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПапкиНаДиске(Команда)
	
    
     Если ПустаяСтрока(ПутьККаталогу) Тогда
        Возврат;
    КонецЕсли;
    
    МассивПутей = ПолучитьМассивПутейПапокНаСервере();
    
    Если МассивПутей.Количество() = 0 Тогда
		Возврат;
    КонецЕсли;
    
    СозданоПапок = 0;
    
    Для Каждого ПутьПапки Из МассивПутей Цикл
        КаталогФайл = Новый Файл(ПутьПапки);
        Если НЕ КаталогФайл.Существует() Тогда
            СоздатьКаталог(ПутьПапки);
            СозданоПапок = СозданоПапок + 1;
        КонецЕсли;
    КонецЦикла;
    
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивПутейПапокНаСервере()
	
    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |    СтруктураКаталога.Ссылка КАК Ссылка
        |ИЗ
        |    Справочник.аск_сод_СтруктураКаталогаЗагрузки КАК СтруктураКаталога
        |ГДЕ
        |    НЕ СтруктураКаталога.ПометкаУдаления";
    
    Выборка = Запрос.Выполнить().Выбрать();
    
    МассивПутей = Новый Массив;
    
    Пока Выборка.Следующий() Цикл
        
        ПолныйПуть = ПостроитьПолныйПутьЭлемента(Выборка.Ссылка, ПутьККаталогу);
        МассивПутей.Добавить(ПолныйПуть);
        
    КонецЦикла;
    
       Для й = 0 По МассивПутей.ВГраница() - 1 Цикл
        Для к = й + 1 По МассивПутей.ВГраница() Цикл
            Если СтрДлина(МассивПутей[й]) > СтрДлина(МассивПутей[к]) Тогда
                Буфер          = МассивПутей[й];
                МассивПутей[й] = МассивПутей[к];
                МассивПутей[к] = Буфер;
			КонецЕсли;
			КонецЦикла;
    КонецЦикла;
    
    Возврат МассивПутей;
КонецФункции

&НаСервере
Функция ПостроитьПолныйПутьЭлемента(Ссылка,КорневойПуть)
    
	ЦепочкаПапок = Новый Массив;
    ТекущийОбъект = Ссылка;
    
    Пока Истина Цикл
        
        Если ТекущийОбъект = Неопределено Тогда
            Прервать;
        КонецЕсли;
        
        Попытка
            Если ТекущийОбъект.Пустая() Тогда
                Прервать;
            КонецЕсли;
        Исключение
            Прервать;
        КонецПопытки;
        
        ЦепочкаПапок.Добавить(ТекущийОбъект.Наименование);
        
        Если ТекущийОбъект.Родитель.Пустая() Тогда
            Прервать;
        КонецЕсли;
        
        ТекущийОбъект = ТекущийОбъект.Родитель;
        
    КонецЦикла;
	
	ЧастиПути = Новый Массив;
	ЧастиПути.Добавить(КорневойПуть);

	Для й = -ЦепочкаПапок.ВГраница() По 0 Цикл
	    ЧастиПути.Добавить(ЦепочкаПапок[-й]);
	КонецЦикла;

	Возврат СтрСоединить(ЧастиПути, "\");

КонецФункции


&НаСервере
Процедура ИзменитьПутьНаСервере() 
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|    СтруктураКаталога.Ссылка         КАК Ссылка,
	|    СтруктураКаталога.Наименование   КАК Наименование,
	|    СтруктураКаталога.Родитель       КАК Родитель,
	|    СтруктураКаталога.СпособЗагрузкиИзКаталога КАК СпособЗагрузки
	|ИЗ
	|    Справочник.аск_сод_СтруктураКаталогаЗагрузки КАК СтруктураКаталога
	|ГДЕ
	|    НЕ СтруктураКаталога.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|    СтруктураКаталога.Ссылка ИЕРАРХИЯ";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
    
	КэшПутей = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.СпособЗагрузки) Тогда
			КэшПутей.Вставить(Выборка.Ссылка, ""); 
			ЗаписатьПуть(Выборка.Ссылка, "");
			Продолжить;
		КонецЕсли;
		
		
		ПутьРодителя = "";
		Если ЗначениеЗаполнено(Выборка.Родитель) Тогда
			ПутьРодителя = КэшПутей[Выборка.Родитель];
			Если ПутьРодителя = Неопределено Тогда
				ПутьРодителя = "";
			КонецЕсли;
		КонецЕсли;
		
		
		Если ПутьРодителя = "" Тогда
			ПолныйПуть = Выборка.Наименование;
		Иначе
			ПолныйПуть = ПутьРодителя + "\" + Выборка.Наименование;
		КонецЕсли;
        
        
        КэшПутей.Вставить(Выборка.Ссылка, ПолныйПуть);
        ЗаписатьПуть(Выборка.Ссылка, ПолныйПуть);
        
    КонецЦикла;	
		
КонецПроцедуры


&НаКлиенте
Процедура ИзменитьПуть(Команда) 

        ИзменитьПутьНаСервере();
        Оповестить("аск_сод_СтруктураКаталогаЗагрузки");          

КонецПроцедуры



&НаСервере
Процедура ЗаписатьПуть(Ссылка, ПолныйПуть)
    
    Объект = Ссылка.ПолучитьОбъект();
    Объект.ПолныйПутьККаталогу = ПолныйПуть;
   
    Объект.ОбменДанными.Загрузка = Истина;
    Объект.Записать();
    
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПолныйПутьККаталогу(Команда)
	ЗаполнитьПолныйПутьККаталогуНаСервере();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьПолныйПутьККаталогуНаСервере()
   
    // Начинаем рекурсивный обход с корня (пустая ссылка)
    ЗаполнитьПутиРекурсивно(Справочники.аск_сод_СтруктураКаталогаЗагрузки.ПустаяСсылка(), "");
    
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьПутиРекурсивно(Знач ТекущийРодитель, Знач ПутьРодителя)
    
    // Получаем выборку элементов, у которых Родитель = ТекущийРодитель
    Выборка = Справочники.аск_сод_СтруктураКаталогаЗагрузки.Выбрать(ТекущийРодитель);
    
    Пока Выборка.Следующий() Цикл
        
        // Формируем путь по условию:
        // Если у элемента нет родителя (корневой уровень), то путь = просто Наименование
        // Иначе: ПутьРодителя + "\" + Наименование
        Если ПустаяСтрока(ПутьРодителя) Тогда
            ТекущийПуть = Выборка.Наименование;
        Иначе
            ТекущийПуть = ПутьРодителя + "\" + Выборка.Наименование;
        КонецЕсли;
        
        // Обновляем реквизит только если он действительно изменился (экономим ресурсы БД)
        Если Выборка.ПолныйПутьККаталогу <> ТекущийПуть Тогда
            
            Объект = Выборка.ПолучитьОбъект();
            Объект.ПолныйПутьККаталогу = ТекущийПуть;
            
            // Включаем режим загрузки, чтобы отключить контроль изменения и обработчики событий
            Объект.ОбменДанными.Загрузка = Истина; 
            Объект.Записать();
            
        КонецЕсли;
        
        // Рекурсивно спускаемся ниже, передавая текущий элемент как родителя и его путь
        ЗаполнитьПутиРекурсивно(Выборка.Ссылка, ТекущийПуть);
        
    КонецЦикла;
    
КонецПроцедуры
