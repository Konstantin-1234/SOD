
&НаСервере
Процедура аск_сод_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	//+Шерер
	//Нужно будет сделать что бы этот код выполнялся при смене вида документа
	Свойство_ФинансовыйШифр = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","ФинансовыйШифр");
	ИспользуетсяФинШифр = ( Неопределено<>Объект.ВидДокумента.НаборСвойств.ДополнительныеРеквизиты.Найти(Свойство_ФинансовыйШифр, "Свойство") );	
	
	Если ИспользуетсяФинШифр Тогда 
		ВключитьТЧФинансовыеШифрыНаФорму(ЭтаФорма);
	Иначе
		ВыключитьТЧФинансовыеШифрыНаФорму(ЭтаФорма);
	КонецЕсли;
	//-Шерер
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВключитьТЧФинансовыеШифрыНаФорму(Форма)
	ИмяТаблицы = "аск_сод_ФинансовыеШифры";
	
	// Проверяем, не добавлена ли таблица ранее (защита от повторного вызова)
	Если Форма.Элементы.Найти(ИмяТаблицы) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Получаем ссылку на группу-контейнер, в которую будем помещать таблицу
	ГруппаФинШифры = Форма.Элементы.аск_сод_ГруппаФинансовыеШифры;
	
	//++Кузнецов
	// *** ПЕРЕМЕЩАЕМ ГРУППУ ПЕРЕД «ГруппаРеквизиты» ***
    Форма.Элементы.Переместить(
        ГруппаФинШифры,
        ГруппаФинШифры.Родитель,
        Форма.Элементы.ГруппаРеквизиты);
	//--Кузнецов
	
	// ==== 1. Создаём саму таблицу (Табличная часть) ====
	ТаблицаФинШифры = Форма.Элементы.Добавить(
		ИмяТаблицы,
		Тип("ТаблицаФормы"),
		ГруппаФинШифры);
	
	ТаблицаФинШифры.Заголовок          = "Финансовые шифры";
	ТаблицаФинШифры.ПутьКДанным        = "Объект.аск_сод_ФинансовыеШифры";
	//++Кузнецов динамическая растяжка по высоте максимум 3.
	ТаблицаФинШифры.РастягиватьПоВертикали = Ложь;
	КоличествоСтрок = Форма.Объект.аск_сод_ФинансовыеШифры.Количество();
	ТаблицаФинШифры.Высота = Мин(Макс(КоличествоСтрок, 1), 3) + 1; 
	ТаблицаФинШифры.УстановитьДействие("ПриОкончанииРедактирования", "аск_сод_ТаблицаФинШифрыПриИзменении");
	ТаблицаФинШифры.УстановитьДействие("ПриАктивизацииСтроки",       "аск_сод_ТаблицаФинШифрыПриИзменении");
	//--Кузнецов
	
	// ==== 2. Колонка "Номер строки" ====
	ЭлементНомерСтроки = Форма.Элементы.Добавить(
		ИмяТаблицы + "НомерСтроки",
		Тип("ПолеФормы"),
		ТаблицаФинШифры);
	ЭлементНомерСтроки.ПутьКДанным        = "Объект.аск_сод_ФинансовыеШифры.НомерСтроки";
	ЭлементНомерСтроки.Заголовок          = "";
	ЭлементНомерСтроки.Ширина             = 1;
	
	// ==== 3. Колонка "Финансовый шифр" (ссылка) ====
	ЭлементФинШифр = Форма.Элементы.Добавить(
		ИмяТаблицы + "ФинансовыйШифр",
		Тип("ПолеФормы"),
		ТаблицаФинШифры);
	ЭлементФинШифр.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементФинШифр.ПутьКДанным     = "Объект.аск_сод_ФинансовыеШифры.ФинансовыйШифр";
	ЭлементФинШифр.Заголовок       = "Финансовый шифр";
	ЭлементФинШифр.Ширина          = 25;
	ЭлементФинШифр.Вид = ВидПоляФормы.ПолеВвода;  
	
	//++Кузнецов
	ЭлементФинШифр.УстановитьДействие("НачалоВыбора", "аск_сод_ФинШифрНачалоВыбора");
	ЭлементФинШифр.УстановитьДействие("ОбработкаВыбора", "аск_сод_ФинШифрОбработкаВыбора");
	//--Кузнецов
	
	// ==== 4. Колонка "Финансовый шифр.Наименование" ====
	ЭлементФинШифрНаименование = Форма.Элементы.Добавить(
		ИмяТаблицы + "ФинансовыйШифрНаименование",
		Тип("ПолеФормы"),
		ТаблицаФинШифры);
	ЭлементФинШифрНаименование.ПутьКДанным     = "Объект.аск_сод_ФинансовыеШифры.ФинансовыйШифр.Наименование";
	ЭлементФинШифрНаименование.Заголовок       = "Наименование";
	ЭлементФинШифрНаименование.Ширина          = 0;
	ЭлементФинШифрНаименование.АвтоМаксимальнаяШирина = Ложь;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВыключитьТЧФинансовыеШифрыНаФорму(Форма)

	ИмяТаблицы = "аск_сод_ФинансовыеШифры";
	
	// Проверяем, не добавлена ли таблица ранее (защита от повторного вызова)
	Если Форма.Элементы.Найти(ИмяТаблицы) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Форма.Элементы.Удалить(Форма.Элементы[ИмяТаблицы])

КонецПроцедуры

&НаКлиенте
Процедура аск_сод_ПослеЗаписиПосле(ПараметрыЗаписи)
	//+Шерер
	//При записи меняется представление ДопРеквизита ФинансовыйШифр. нужно обновить информцию на форме
	ЭтаФорма.Прочитать();
	//+Шерер
КонецПроцедуры   

//++Кузнецов
&НаКлиенте
Процедура аск_сод_ТаблицаФинШифрыПриИзменении(Элемент, СтандартнаяОбработка = Истина, Отказ = Ложь) Экспорт
    
    Количество = Объект.аск_сод_ФинансовыеШифры.Количество();
    НоваяВысота = Мин(Макс(Количество, 1), 3) + 1;
    
    Если Элемент.Высота <> НоваяВысота Тогда
        Элемент.Высота = НоваяВысота;
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура аск_сод_ФинШифрНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
       // Открываем форму выбора в режиме множественного выбора
    ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("РежимВыбора", Истина);
    ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
    
    ОткрытьФорму("Справочник.аск_сод_ФинансовыеШифры.ФормаВыбора", 
                 ПараметрыФормы, 
                 Элемент);
    
    СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура аск_сод_ФинШифрОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
    // 1. Отключаем стандартную обработку, так как мы сами разнесем данные
    СтандартнаяОбработка = Ложь;
    
    // 2. Формируем массив выбранных значений
    МассивВыбранных = Новый Массив;
    
    ТипВыбранного = ТипЗнч(ВыбранноеЗначение);
    Если ТипВыбранного = Тип("Массив") Или ТипВыбранного = Тип("ФиксированныйМассив") Тогда
        Для Каждого Значение Из ВыбранноеЗначение Цикл
            МассивВыбранных.Добавить(Значение);
        КонецЦикла;
    ИначеЕсли ВыбранноеЗначение <> Неопределено Тогда
        МассивВыбранных.Добавить(ВыбранноеЗначение);
    КонецЕсли;
    
    Если МассивВыбранных.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    
    // 3. Получаем ту самую пустую строку, из которой был начат выбор
    ТекущаяСтрока = Элементы.аск_сод_ФинансовыеШифры.ТекущиеДанные;
    
    // 4. Распределяем значения
    Для Каждого ФинШифр Из МассивВыбранных Цикл
        
        // Проверка на дубль
        ДубльНайден = Ложь;
        Для Каждого СтрокаТЧ Из Объект.аск_сод_ФинансовыеШифры Цикл
            Если СтрокаТЧ.ФинансовыйШифр = ФинШифр Тогда
                ДубльНайден = Истина;
                Прервать;
            КонецЕсли;
        КонецЦикла;
        
        Если Не ДубльНайден Тогда
            
            Если ТекущаяСтрока <> Неопределено Тогда
                // Пишем первое выбранное значение в текущую строку
                ТекущаяСтрока.ФинансовыйШифр = ФинШифр;
                // Очищаем переменную, чтобы следующие значения пошли в .Добавить()
                ТекущаяСтрока = Неопределено; 
            Иначе
                // Добавляем новую строку для второго и последующих значений
                НоваяСтрока = Объект.аск_сод_ФинансовыеШифры.Добавить();
                НоваяСтрока.ФинансовыйШифр = ФинШифр;
            КонецЕсли;
            
        КонецЕсли;
        
    КонецЦикла;
    
    Модифицированность = Истина;
КонецПроцедуры

