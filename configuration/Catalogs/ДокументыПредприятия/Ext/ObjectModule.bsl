
&Перед("ПередЗаписью")
Процедура аск_сод_ПередЗаписью(Отказ)
	//+Шерер
	Свойство_ФинансовыйШифр = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","ФинансовыйШифр");
	ИспользуетсяФинШифр = ( Неопределено<>ЭтотОбъект.ВидДокумента.НаборСвойств.ДополнительныеРеквизиты.Найти(Свойство_ФинансовыйШифр, "Свойство") );	
	
	Если ЭтотОбъект.ПометкаУдаления = Истина
	 ИЛИ ОбменДанными.Загрузка = Истина
	   //ЭтотОбъект.ДополнительныеСвойства.Свойство("ЗагрузкаДокументовСОД") И ЭтотОбъект.ДополнительныеСвойства.ЗагрузкаДокументовСОД = Истина 
	Тогда
		//Не делаю проверку на заполненность табличной части ФинансовыеШифры	
	Иначе
		//Действия, если НЕ ЭтотОбъект.ДополнительныеСвойства.Загрузка 
		#Область ПроверкаФинШифра
		Если ИспользуетсяФинШифр И ЭтотОбъект.аск_сод_ФинансовыеШифры.Количество()=0 Тогда 
			Отказ = Истина;
			Сообщить("Пустой Финансовый шифр! для вида документов "+ЭтотОбъект.ВидДокумента + " заполнение финансового шифра обязательно!");
		КонецЕсли;
		#КонецОбласти
	КонецЕсли;
		
	#Область ЗаполнениеПредставленияФинШифра
	Если ЭтотОбъект.ПометкаУдаления = ЛОЖЬ 
	   И ИспользуетсяФинШифр 
	Тогда 
		//1. формирую Новое представление финансового шифра
		ПредставлениеФинансовогоШифра = "♫";  //Пометка начала строки
		Для Каждого ФинШифр Из ЭтотОбъект.аск_сод_ФинансовыеШифры Цикл
			Если ЗначениеЗаполнено(ФинШифр.ФинансовыйШифр) Тогда
				ПредставлениеФинансовогоШифра = ПредставлениеФинансовогоШифра+"; "+ФинШифр.ФинансовыйШифр.Код;
			КонецЕсли;
		КонецЦикла;
		ПредставлениеФинансовогоШифра = СтрЗаменить(ПредставлениеФинансовогоШифра,"♫; ",""); //Удаляю первую ";"
		ПредставлениеФинансовогоШифра = СтрЗаменить(ПредставлениеФинансовогоШифра,"♫"  ,"");   //Удаляю "♫", если ПредставлениеФинансовогоШифра не менялось
		
		// Собираем все строки с нужным свойством в массив
		НайденныеСтроки = Новый Массив;
		Для Каждого стрДопРеквизиты Из ЭтотОбъект.ДополнительныеРеквизиты Цикл
			Если стрДопРеквизиты.Свойство = Свойство_ФинансовыйШифр Тогда
				НайденныеСтроки.Добавить(стрДопРеквизиты);
			КонецЕсли;
		КонецЦикла;
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			// Обновляем значение в первой найденной строке
			НайденныеСтроки[0].Значение = ПредставлениеФинансовогоШифра;
			
			// Удаляем все дублирующие строки (начиная со второй), чтобы осталась одна (для предотвращения дублирования строк)
			КоличествоСтрок = НайденныеСтроки.Количество();
			Для й = 1 По КоличествоСтрок-1 Цикл //вычитаю 1, что бы пропустить первую строку
				ЭтотОбъект.ДополнительныеРеквизиты.Удалить(НайденныеСтроки[КоличествоСтрок-й]);
			КонецЦикла;
		Иначе
			// Если строк нет вообще (ни из шаблона, ни от БСП), добавляем новую
			НоваяСтрока = ЭтотОбъект.ДополнительныеРеквизиты.Добавить();
			НоваяСтрока.Свойство = Свойство_ФинансовыйШифр;
			НоваяСтрока.Значение = ПредставлениеФинансовогоШифра;
		КонецЕсли;
		
	Иначе
		ЭтотОбъект.аск_сод_ФинансовыеШифры.Очистить();
		//Надеюсь, что БСП самостоятельно очистит ТЧ "ДополнительныеРеквизиты"
	КонецЕсли;
	#КонецОбласти
	//-Шерер
КонецПроцедуры


