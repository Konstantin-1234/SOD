&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	//+Устанавливаю значения констант
	_УСПЕХ_=1;
	_РАНЕЕ_=2;
	_БЕДА_=0;
	//-Устанавливаю значения констант
	
	ЗагрузитьНастройки();
	
КонецПроцедуры

#Область Управление_настройками_пользователя

&НаСервере
Процедура ЗагрузитьНастройки()
	
	Если Параметры.Свойство("ПараметрыОткрытия") Тогда
		ЗначениеНастройки = Параметры.ПараметрыОткрытия;
	Иначе
		ИмяНастройки = "ЗагрузитьДокументыСОД";
		КлючНастройки = "ПараметрыЗагрузки";
		
		ЗначениеНастройки = ХранилищеНастроекДанныхФорм.Загрузить(ИмяНастройки, КлючНастройки);
	КонецЕсли;
	
	Если ЗначениеНастройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеНастройки) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Объект,ЗначениеНастройки);
	КонецЕсли;
	
	Объект.ФинансовыеШифры.Очистить();
	Если ЗначениеНастройки.Свойство("тзФинансовыеШифры") тогда 
	ФинансовыеШифрыСохраненные = ЗначениеИзСтрокиВнутр(ЗначениеНастройки.тзФинансовыеШифры);
	Если ТипЗнч(ФинансовыеШифрыСохраненные) = тип("ТаблицаЗначений") Тогда
		Для Каждого стрФинШифрыСохраненные из ФинансовыеШифрыСохраненные Цикл 
			новСтр = Объект.ФинансовыеШифры.Добавить();
			ЗаполнитьЗначенияСвойств(новСтр,стрФинШифрыСохраненные);
		КонецЦикла;
	КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере()
	
		
	ЗначениеНастройки = Новый Структура;
	ЗначениеНастройки.Вставить("КаталогПроекта", Объект.КаталогПроекта);
	ЗначениеНастройки.Вставить("КаталогНачалаЗагрузки", Объект.КаталогНачалаЗагрузки);
	ЗначениеНастройки.Вставить("Проект", Объект.Проект);
	ЗначениеНастройки.Вставить("Организация", Объект.Организация);
	ЗначениеНастройки.Вставить("Контрагент", Объект.Контрагент);
	ЗначениеНастройки.Вставить("РазделительЗагрузки", Объект.РазделительЗагрузки);
	ЗначениеНастройки.Вставить("тзФинансовыеШифры", ЗначениеВСтрокуВнутр(Объект.ФинансовыеШифры.Выгрузить()));
	
	ИмяНастройки = "ЗагрузитьДокументыСОД";
	КлючНастройки = "ПараметрыЗагрузки";
	
	ХранилищеНастроекДанныхФорм.Сохранить(ИмяНастройки, КлючНастройки, ЗначениеНастройки);
КонецПроцедуры

&НаКлиенте
Процедура РеквизитШапкиФормыПриИзменении(Элемент)
	СохранитьНастройкиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура КаталогПроектаПриИзменении(Элемент)
	Объект.КаталогНачалаЗагрузки = Объект.КаталогПроекта;
	//Объект.Контрагент = Неопределено;
	//Объект.Организация = Неопределено;
	//Объект.Проект = Неопределено;
	//Объект.РазделительЗагрузки = Неопределено;
	
	СохранитьНастройкиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура РазделительЗагрузкиПриИзменении(Элемент)
	Объект.Проект = Неопределено;
	Объект.Контрагент = Неопределено;
	Объект.Организация = Неопределено;
	
	СохранитьНастройкиНаСервере();
КонецПроцедуры
#КонецОбласти

// Обработчик события начала выбора для поля "Каталог проекта".
// Открывает диалог выбора каталога и устанавливает выбранный путь в реквизит формы.
//
// Параметры:
//  Элемент - ПолеФормы - поле формы, для которого возникло событие;
//  ДанныеВыбора - ДанныеВыбораИзПоляВвода - данные выбора, сформированные полем ввода;
//  ВыборДобавлением - Булево - признак того, что выбор был осуществлен путем добавления новой строки;
//  СтандартнаяОбработка - Булево - признак необходимости выполнения стандартной обработки события.
//
&НаКлиенте
Процедура КаталогПроектаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
    ДиалогВыбора.Заголовок = "Выберите каталог проекта";
	Если ДиалогВыбора.Выбрать() Тогда
        Объект[Элемент.Имя] = ДиалогВыбора.Каталог;
        Объект.КаталогНачалаЗагрузки = ДиалогВыбора.Каталог;
	КонецЕсли;
	
	СохранитьНастройкиНаСервере();	
КонецПроцедуры

// Рекурсивно обходит файловую систему начиная с указанного каталога и собирает полные пути всех найденных файлов.
//
// Параметры:
//  ПутьКаталога - Строка - полный путь к каталогу на диске, в котором выполняется поиск.
//
// Возвращаемое значение:
//  Массив - массив строк, содержащий полные пути ко всем найденным файлам.
//
&НаКлиенте
Функция НайтиФайлыРекурсивноНаКлиенте(ПутьКаталога)
	
    Результат = Новый Массив;
    ЭлементыФС = НайтиФайлы(ПутьКаталога, "*", Ложь);
    Для Каждого Элемент Из ЭлементыФС Цикл
        Если Элемент.ЭтоКаталог() Тогда
            
            Вложенные = НайтиФайлыРекурсивноНаКлиенте(Элемент.ПолноеИмя);
            Для Каждого ВложФайл Из Вложенные Цикл
                Результат.Добавить(ВложФайл);
            КонецЦикла;
        ИначеЕсли ЭтоФайлСОД(Элемент) Тогда
            Результат.Добавить(Элемент.ПолноеИмя);
		Иначе
			// это файл не СОД, его не нужно загружать
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;

КонецФункции

// Рекурсивно обходит каталог и формирует структуру описаний всех найденных папок,
// включая списки файлов в каждой папке и ее подпапках.
//
// Параметры:
//  ПутьКаталога - Строка - путь к каталогу, который необходимо обойти;
//  СтруктураПапок - Массив - массив, в который будут добавляться описания найденных папок;
//  РодительскоеПолноеИмя - Строка - полное имя родительской папки (используется при рекурсивном вызове).
//
&НаКлиенте
Процедура ОбходПапокНаКлиенте(ПутьКаталога, СтруктураПапок, РодительскоеПолноеИмя = "")
	
    ЭлементыФС = НайтиФайлы(ПутьКаталога, "*", Ложь);
    Для Каждого Элемент Из ЭлементыФС Цикл
        Если НЕ Элемент.ЭтоКаталог() Тогда
            Продолжить;
        КонецЕсли;
        ОписаниеПапки = Новый Структура;
        ОписаниеПапки.Вставить("ИмяПапки",             НРег(СокрЛП(Элемент.Имя)));
        ОписаниеПапки.Вставить("ПолноеИмяПапки",       Элемент.ПолноеИмя);
        ОписаниеПапки.Вставить("Файлы",                НайтиФайлыРекурсивноНаКлиенте(Элемент.ПолноеИмя));
        ОписаниеПапки.Вставить("ФайлыТолькоЭтойПапки", НайтиФайлыТолькоВПапке(Элемент.ПолноеИмя));  
		ОписаниеПапки.Вставить("ФайлыСГруппами",       СобратьФайлыПервогоУровняСГруппами(Элемент.ПолноеИмя));
        ОписаниеПапки.Вставить("РодительскоеПолноеИмя", РодительскоеПолноеИмя); 
        СтруктураПапок.Добавить(ОписаниеПапки);
        ОбходПапокНаКлиенте(Элемент.ПолноеИмя, СтруктураПапок, Элемент.ПолноеИмя);
	КонецЦикла;
	
КонецПроцедуры


// Выполняет поиск файлов только в указанном каталоге, без рекурсивного обхода вложенных папок.
//
// Параметры:
//  ПутьКаталога - Строка - полный путь к каталогу для поиска.
//
// Возвращаемое значение:
//  Массив - массив строк, содержащий полные пути к файлам, находящимся непосредственно в указанном каталоге.
//
&НаКлиенте
Функция НайтиФайлыТолькоВПапке(ПутьКаталога) 
	
    Результат = Новый Массив;
    ЭлементыФС = НайтиФайлы(ПутьКаталога, "*", Ложь);
    Для Каждого Элемент Из ЭлементыФС Цикл
        Если Элемент.ЭтоФайл() И ЭтоФайлСОД(Элемент) Тогда
            Результат.Добавить(Элемент.ПолноеИмя);
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
	
КонецФункции

// Обработчик команды "Загрузить документы".
// Инициирует процесс загрузки документов из файловой системы в 1С:Документооборот,
// выполняет подготовку данных, запуск обхода папок и старт асинхронной загрузки.
//
// Параметры:
//  Команда - КомандаФормы - команда формы, вызвавшая данное событие.
//
&НаКлиенте
Процедура ЗагрузитьДокументы(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.КаталогПроекта) Тогда
        Сообщить("Не указан каталог проекта.", СтатусСообщения.Важное);
        Возврат;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Объект.КаталогНачалаЗагрузки)
		ИЛИ НЕ СтрНачинаетсяС(Объект.КаталогНачалаЗагрузки, Объект.КаталогПроекта)
	Тогда
        Сообщить("Каталог начала загрузки указан не корректно.", СтатусСообщения.Важное);
        Возврат;
    КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.РазделительЗагрузки) Тогда
        Сообщить("Не указан РазделительЗагрузки.", СтатусСообщения.Важное);
        Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
        Сообщить("Не указана Организация.", СтатусСообщения.Важное);
        Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Проект) Тогда
        Сообщить("Не указан Проект.", СтатусСообщения.Важное);
        Возврат;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
        Сообщить("Не указан Контрагент.", СтатусСообщения.Важное);
        Возврат;
	КонецЕсли;
	
	СтартЗагрузкиНаСервере();
	
	ТочкаСтарта = СокрЛП(Объект.КаталогНачалаЗагрузки);
	
	//+Считаю общее количество файлов к загрузке
	ЭтаФорма.ВсегоФайлов = 0;
	ЭлементыФС = НайтиФайлы(ТочкаСтарта, "*", ИСТИНА);
    Для Каждого ЭлементФС Из ЭлементыФС Цикл
		Если ЭтоФайлСОД(ЭлементФС) Тогда
            ЭтаФорма.ВсегоФайлов = ЭтаФорма.ВсегоФайлов +1;
			Добавить_ТЧ_ФайлыВсего(ЭлементФС.Путь,ЭлементФС.ИмяБезРасширения+"."+ЭлементФС.Расширение);
		Иначе 
			//Либо каталог, либо это файл не СОД, его не нужно загружать
        КонецЕсли;
	КонецЦикла;
	//-Считаю общее количество файлов к загрузке
 
    ОстановитьЗагрузку = Ложь;
    СтруктураПапок = Новый Массив;

	ОбходПапокНаКлиенте(ТочкаСтарта, СтруктураПапок);

    УникальныеПути = Новый Соответствие;
    Для Каждого ОписаниеПапки Из СтруктураПапок Цикл
        Для Каждого ПутьФайла Из ОписаниеПапки.Файлы Цикл
            УникальныеПути.Вставить(ПутьФайла, Истина);
        КонецЦикла;
    КонецЦикла;

	//Сообщить("Найдено папок: " + СтруктураПапок.Количество()
		//+ ", файлов: " + УникальныеПути.Количество());

    ОтчетОбщий = Новый Структура;
    ОтчетОбщий.Вставить("НовыеДокументы",         Новый Массив);
    ОтчетОбщий.Вставить("СуществующиеДокументы",  Новый Массив);
    ОтчетОбщий.Вставить("ОшибкиДокументов",       Новый Массив);
    ОтчетОбщий.Вставить("ОшибкиФайлов",           Новый Массив);
    ОтчетОбщий.Вставить("СсылкиОшибокДокументов", Новый Массив);
	ОтчетОбщий.Вставить("ВсегоФайлов",     0);  
	ОтчетОбщий.Вставить("ФайловЗагружено", 0);  
	ОтчетОбщий.Вставить("ФайловПропущено", 0);  
	ОтчетОбщий.Вставить("ФайловСуществовало", 0);
	
    Контекст = Новый Структура;
    Контекст.Вставить("СтруктураПапок",  СтруктураПапок);
    Контекст.Вставить("ТекущийИндекс",   0);
    Контекст.Вставить("ОтчетОбщий",      ОтчетОбщий);
    КонтекстЗагрузки = Контекст;
	
	ПодключитьОбработчикОжидания("ШагЗагрузки", 0.1, Истина);
	
КонецПроцедуры 

&НаСервере
Процедура СтартЗагрузкиНаСервере()
	
	ЭтаФорма.ВремяНачалаЗагрузки = ТекущаяДатаСеанса();
	Объект.РезультатыЗагрузкиДокументов.Очистить();
	Объект.РезультатыЗагрузкиФайлов.Очистить();
	Объект.ФайлыВсего.Очистить();
	
КонецПроцедуры
	
// Выполняет один шаг асинхронной загрузки документов.
// Обрабатывает одну папку из очереди, прикрепляет файлы к созданным документам,
// обновляет статистику и планирует следующий шаг через обработчик ожидания.
//
&НаКлиенте
Процедура ШагЗагрузки()
	
	СтруктураПапок = КонтекстЗагрузки.СтруктураПапок;
    ТекущийИндекс  = КонтекстЗагрузки.ТекущийИндекс;
    ОтчетОбщий     = КонтекстЗагрузки.ОтчетОбщий;

    Если ОстановитьЗагрузку Тогда
        Сообщить("Загрузка остановлена пользователем на папке "
            + ТекущийИндекс + " / " + СтруктураПапок.Количество());
        ВывестиИтоговыйОтчет(ОтчетОбщий);
        Возврат;
    КонецЕсли;

    Если ТекущийИндекс >= СтруктураПапок.Количество() Тогда
        ВывестиИтоговыйОтчет(ОтчетОбщий);
        Возврат;
    КонецЕсли;

    ОписаниеПапки = СтруктураПапок[ТекущийИндекс];
    ТекущийИндекс = ТекущийИндекс + 1;

    ТекстСостояние = "Папка (" + ТекущийИндекс
        + " из " + СтруктураПапок.Количество() + "): "
        + ОписаниеПапки.ПолноеИмяПапки;
    ОбновитьОтображениеДанных();

	Если ОписаниеПапки.Файлы.Количество() > 0 Тогда
		ОтчетПапки = ОбработатьПапкуНаСервере(ОписаниеПапки);	
		Если ОтчетПапки <> Неопределено Тогда
			НомерФайла = 1;
			Для Каждого Элемент Из ОтчетПапки.ФайлыДляПрикрепления Цикл
    			ЭтаФорма.ТекстСостояние = "Папка (" + ТекущийИндекс+"."+НомерФайла+" / " + СтруктураПапок.Количество() + "): " + ОписаниеПапки.ПолноеИмяПапки;
    			ОбновитьОтображениеДанных();
				НомерФайла = НомерФайла+1;
				ВыполнитьПрикреплениеФайлов(Элемент.Ключ, Элемент.Значение.СсылкаНаДокумент,Элемент.Значение.ИмяПапки, ОтчетПапки);
			КонецЦикла;
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
			ОтчетОбщий.НовыеДокументы,        ОтчетПапки.НовыеДокументы);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
			ОтчетОбщий.СуществующиеДокументы, ОтчетПапки.СуществующиеДокументы);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
			ОтчетОбщий.ОшибкиДокументов,      ОтчетПапки.ОшибкиДокументов);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
			ОтчетОбщий.ОшибкиФайлов,          ОтчетПапки.ОшибкиФайлов);
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
			ОтчетОбщий.СсылкиОшибокДокументов, ОтчетПапки.СсылкиОшибокДокументов);
			ОтчетОбщий.ВсегоФайлов     = ОтчетОбщий.ВсегоФайлов + ОтчетПапки.ВсегоФайлов;
			ОтчетОбщий.ФайловЗагружено = ОтчетОбщий.ФайловЗагружено + ОтчетПапки.ФайловЗагружено;
			ОтчетОбщий.ФайловПропущено = ОтчетОбщий.ФайловПропущено + ОтчетПапки.ФайловПропущено;
			ОтчетОбщий.ФайловСуществовало = ОтчетОбщий.ФайловСуществовало + ОтчетПапки.ФайловСуществовало;
		КонецЕсли;
	КонецЕсли;

    КонтекстЗагрузки.ТекущийИндекс = ТекущийИндекс;
    КонтекстЗагрузки.ОтчетОбщий    = ОтчетОбщий;
    ПодключитьОбработчикОжидания("ШагЗагрузки", 0.1, Истина);
	
КонецПроцедуры

// Выполняет чтение файла с диска и его прикрепление к указанному документу,
// а также обновляет статистику по результатам прикрепления.
//
// Параметры:
//  ПутьФайла - Строка - полный путь к файлу на диске;
//  СсылкаНаДокумент - СправочникСсылка.ДокументыПредприятия - ссылка на документ, к которому прикрепляется файл;
//  ИмяПапки - Строка - имя папки, из которой был загружен файл (используется для определения роли файла);
//  ОтчетПоДокументам - Структура - структура для сбора статистики и ошибок по текущей папке.
//
&НаКлиенте
Процедура ВыполнитьПрикреплениеФайлов(ПутьФайла, СсылкаНаДокумент, ИмяПапки, ОтчетПоДокументам) 
    РезультатПрикрепления = Новый Структура("Загружено, НеЗагружено, Существовало", 0, 0, 0);
	
	//+Шерер: что бы работало быстрее, экономлю на чтении двоичных данных
	СуществующийФайл = НайтиСуществующийФайл(СсылкаНаДокумент, ПутьФайла);
	Если СуществующийФайл = Неопределено Тогда
	//-Шерер: что бы работало быстрее, экономлю на чтении двоичных данных
		Попытка //пусть будет попытка 
	        ДвоичныеДанные = Новый ДвоичныеДанные(ПутьФайла);
	    Исключение
	        ОтчетПоДокументам.ОшибкиФайлов.Добавить(
	            "Ошибка чтения файла: " + ПутьФайла + " / " + ОписаниеОшибки());
	        ОтчетПоДокументам.ФайловПропущено = ОтчетПоДокументам.ФайловПропущено + 1;
	        Возврат;
	    КонецПопытки;
		
		ПрикрепитьФайлКДокументу(
	        ПутьФайла, ДвоичныеДанные,
	        СсылкаНаДокумент,ИмяПапки, ОтчетПоДокументам, РезультатПрикрепления);
	//+Шерер: что бы работало быстрее, экономлю на чтении двоичных данных
	Иначе
		РезультатПрикрепления.Существовало = РезультатПрикрепления.Существовало + 1; 
	    ЭлементФС = Новый Файл(ПутьФайла);
		Расширение = ЭлементФС.Расширение; 
		//Если Лев(Расширение, 1) = "." Тогда
		//    Расширение = Сред(Расширение, 2);
		//КонецЕсли;
	    ИмяФайла = ЭлементФС.ИмяБезРасширения;
		ДобавитьРезультатЗагрузкиФайла(ЭлементФС.Путь, ЭлементФС.ИмяБезРасширения+"."+ЭлементФС.Расширение, "ПравилоЗагрузки", СуществующийФайл, _РАНЕЕ_, "");
	КонецЕсли;
    //-Шерер: что бы работало быстрее, экономлю на чтении двоичных данных
	
    ОтчетПоДокументам.ФайловЗагружено    = ОтчетПоДокументам.ФайловЗагружено    + РезультатПрикрепления.Загружено;
    ОтчетПоДокументам.ФайловПропущено    = ОтчетПоДокументам.ФайловПропущено    + РезультатПрикрепления.НеЗагружено;
    ОтчетПоДокументам.ФайловСуществовало = ОтчетПоДокументам.ФайловСуществовало + РезультатПрикрепления.Существовало; 
	
КонецПроцедуры

// Рекурсивно обходит справочник "Структура каталога" и формирует соответствие между именами, путями
// и представлениями элементов справочника и их данными (ссылка, способ загрузки, вид документа).
//
// Параметры:
//  Родитель - СправочникСсылка.СтруктураКаталога - ссылка на родительский элемент справочника, с которого начинается обход;
//  СоответствиеСтруктур - Соответствие - соответствие, в которое будут помещаться данные элементов справочника.
//
&НаСервере
Процедура ЗаполнитьСоответствиеСтруктурКаталога(Родитель, СоответствиеСтруктур)
	
	Выборка = Справочники.аск_сод_СтруктураКаталогаЗагрузки.Выбрать(Родитель);
    Пока Выборка.Следующий() Цикл
		
		Если Выборка.ПометкаУдаления Тогда
            Продолжить;
        КонецЕсли;
        Если Выборка.РазделительЗагрузки <> Объект.РазделительЗагрузки Тогда
            Продолжить;
		КонецЕсли;
		
        //ОбъектЭлемента = Выборка.ПолучитьОбъект(); //Тупая ИИшка - не знает для чего используется ПолучитьОбъект()
		//ВидДокумента = Неопределено;
		//Для Каждого СтрокаТЧ Из ОбъектЭлемента.ЗаполнениеРеквизитовДокумента Цикл
		//    Если СтрокаТЧ.РеквизитДокумента
		//        = ПланыВидовХарактеристик.Аск_Реквизиты.ВидДокумента Тогда
		//        ВидДокумента = СтрокаТЧ.Значение;
		//        Прервать;
		//    КонецЕсли;
		//КонецЦикла;
		
		//+Шерер: ВидДокумента теперь берется напрямую из реквизита шапки справочника, а не из табличной части
		ВидДокумента = Выборка.ВидДокумента;
		//-Шерер: ВидДокумента теперь берется напрямую из реквизита шапки справочника, а не из табличной части
		
        ДанныеЭлемента = Новый Структура(
            "Ссылка, СпособЗагрузкиИзКаталога, ВидДокумента, ПолныйПутьККаталогу",
            Выборка.Ссылка,
            Выборка.СпособЗагрузкиИзКаталога,
            ВидДокумента,
            СокрЛП(Выборка.ПолныйПутьККаталогу)); 

        
        ПолныйПуть = НРег(СокрЛП(Выборка.ПолныйПутьККаталогу));
        Если ЗначениеЗаполнено(ПолныйПуть) Тогда
            СоответствиеСтруктур.Вставить(ПолныйПуть, ДанныеЭлемента);
        КонецЕсли;

		
		СоответствиеСтруктур.Вставить(
            НРег(СокрЛП(Выборка.Наименование)), ДанныеЭлемента);
	
	   Для Каждого СтрокаПредставления Из Выборка.Ссылка.ПредставленияКаталога Цикл
            Представление = НРег(СокрЛП(СтрокаПредставления.ПредставлениеКаталога));
            Если ЗначениеЗаполнено(Представление) Тогда
                СоответствиеСтруктур.Вставить(Представление, ДанныеЭлемента);
            КонецЕсли;
        КонецЦикла;

        ЗаполнитьСоответствиеСтруктурКаталога(Выборка.Ссылка, СоответствиеСтруктур);
    КонецЦикла;
	
КонецПроцедуры

// Создает новый элемент справочника "Документы предприятия" с заполнением основных реквизитов
// по шаблону, выполняет проверку на дубликаты и записывает документ в базу данных.
//
// Параметры:
//  ВидДокумента - СправочникСсылка.ВидыДокументов - вид создаваемого документа;
//  Проект - СправочникСсылка.Проекты - проект, к которому относится документ;
//  Организация - СправочникСсылка.Организации - организация, от имени которой создается документ;
//  Контрагент - СправочникСсылка.Контрагенты - контрагент документа;
//  ПолныйПутьПапки - Строка - полный путь к папке на диске (используется для поиска дублей и записи в доп. реквизит);
//  ОтчетПоДокументам - Структура - структура для сбора статистики и ошибок;
//  ОбработанныеПапки - Соответствие - соответствие обработанных папок и созданных документов;
//  ПроверятьДубли - Булево - признак необходимости проверки на существующие документы;
//  СсылкаСтруктуры - СправочникСсылка.СтруктураКаталога - ссылка на элемент справочника "Структура каталога".
//
// Возвращаемое значение:
//  СправочникСсылка.ДокументыПредприятия, Неопределено - ссылка на созданный или существующий документ,
//   либо Неопределено в случае ошибки.
//
&НаСервере
Функция СоздатьДокументСОД(ВидДокумента, Проект, Организация, Контрагент,
    ПолныйПутьПапки = "", ОтчетПоДокументам = Неопределено,
    ОбработанныеПапки = Неопределено, ПроверятьДубли = Истина,
    СсылкаСтруктуры = Неопределено)
	
    Если НЕ ЗначениеЗаполнено(ВидДокумента) Тогда

        ПредставлениеСтруктуры = "";
        Если ЗначениеЗаполнено(СсылкаСтруктуры) Тогда
            ПредставлениеСтруктуры = СсылкаСтруктуры.Наименование
                + " | Путь: " + СокрЛП(СсылкаСтруктуры.ПолныйПутьККаталогу);
        КонецЕсли;

        ТекстОшибки = "Не заполнен ВидДокумента. Папка: [" + ПолныйПутьПапки + "]"
            + ?(ЗначениеЗаполнено(ПредставлениеСтруктуры),
                " | СтруктураКаталога: [" + ПредставлениеСтруктуры + "]",
                "");

        Сообщить(ТекстОшибки, СтатусСообщения.Важное);
        Если ОтчетПоДокументам <> Неопределено Тогда
            ОтчетПоДокументам.ОшибкиДокументов.Добавить(ТекстОшибки);
        КонецЕсли;
		ДобавитьРезультатЗагрузкиДокумента(ПолныйПутьПапки, "", СсылкаСтруктуры, Неопределено, _БЕДА_ , "Не указан ВидДокумента");
        Возврат Неопределено;
    КонецЕсли;

    Если ПроверятьДубли И ЗначениеЗаполнено(ПолныйПутьПапки) Тогда
        СуществующийДок = НайтиСуществующийДокумент(
            ВидДокумента, Проект, Организация, ПолныйПутьПапки);
        Если СуществующийДок <> Неопределено Тогда
			ДобавитьРезультатЗагрузкиДокумента(ПолныйПутьПапки, "", СсылкаСтруктуры, СуществующийДок, _РАНЕЕ_ , "");
            Если ОбработанныеПапки <> Неопределено Тогда
                ОбработанныеПапки.Вставить(ПолныйПутьПапки, СуществующийДок);
			КонецЕсли;
		Если ОтчетПоДокументам <> Неопределено Тогда
                ОтчетПоДокументам.СуществующиеДокументы.Добавить(СуществующийДок);
            КонецЕсли;
            Возврат СуществующийДок;
        КонецЕсли;
    КонецЕсли;

    ВидДокументаОбъект = ВидДокумента.ПолучитьОбъект();

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |    ШаблоныДокументов.Ссылка
        |ИЗ
        |    Справочник.ШаблоныДокументов КАК ШаблоныДокументов
        |ГДЕ
        |    ШаблоныДокументов.ВидДокумента = &ВидДокумента
        |    И НЕ ШаблоныДокументов.ПометкаУдаления";

    Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
    РезультатЗапроса = Запрос.Выполнить();

    ОбъектДО = Справочники.ДокументыПредприятия.СоздатьЭлемент();
    ОбъектДО.ДополнительныеСвойства.Вставить("ЭтоНовый", Истина);

    Если НЕ РезультатЗапроса.Пустой() Тогда
        Выборка = РезультатЗапроса.Выбрать();
        Выборка.Следующий();
		ШаблонЗаполнения = Выборка.Ссылка.ПолучитьОбъект();
        ДанныеЗаполнения = Новый Структура("ШаблонДокумента", ШаблонЗаполнения);
        ДанныеЗаполнения.Вставить("Организация", Организация);
        ОбъектДО.Заполнить(ДанныеЗаполнения);
    КонецЕсли;

    ОбъектДО.ДополнительныеСвойства.Вставить("Модифицированность",                    Истина);
    ОбъектДО.ДополнительныеСвойства.Вставить("ЗаполнятьПоШаблону",                    Истина);
    ОбъектДО.ДополнительныеСвойства.Вставить("ТекущаяДата",                           ТекущаяДата());
    ОбъектДО.ДополнительныеСвойства.Вставить("ТекущийПользователь",                   Пользователи.ТекущийПользователь());
    ОбъектДО.ДополнительныеСвойства.Вставить("ОсновнойСотрудникТекущегоПользователя", Сотрудники.ОсновнойСотрудник());
    ОбъектДО.ДополнительныеСвойства.Вставить("НачальныйРегистрационныйНомер",         "");
    ОбъектДО.ДополнительныеСвойства.Вставить("СрокДействияИзменен",                   Ложь);
    ОбъектДО.ДополнительныеСвойства.Вставить("КэшВидаДокумента",                      Неопределено);
    ОбъектДО.ДополнительныеСвойства.Вставить("Связи",                                 Новый ТаблицаЗначений);

    ОбъектДО.ВидДокумента  = ВидДокумента;
    ОбъектДО.Проект        = Проект;
    ОбъектДО.Ответственный = ПараметрыСеанса.ОсновнойСотрудник; //ПараметрыСеанса.ТекущийПользователь;
    ОбъектДО.Заголовок     = СокрЛП(ВидДокумента.Наименование);

    Если ВидДокументаОбъект.ВестиУчетПоОрганизациям Тогда
        ОбъектДО.Организация = Организация;
	КонецЕсли;
	
	Если ВидДокументаОбъект.ВестиУчетСторон Тогда
        Если ЗначениеЗаполнено(Организация) Тогда
            НайденаОрг = Ложь;
            Для Каждого Строка Из ОбъектДО.Стороны Цикл
                Если Строка.Сторона = Организация Тогда
                    НайденаОрг = Истина;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
            Если НЕ НайденаОрг Тогда
                НоваяСтрока         = ОбъектДО.Стороны.Вставить(0);
                НоваяСтрока.Сторона = Организация;
            КонецЕсли;
        КонецЕсли;
        Если ЗначениеЗаполнено(Контрагент) Тогда
            НайденКонтр = Ложь;
            Для Каждого Строка Из ОбъектДО.Стороны Цикл
                Если Строка.Сторона = Контрагент Тогда
                    НайденКонтр = Истина;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
            Если НЕ НайденКонтр Тогда
                НоваяСтрока         = ОбъектДО.Стороны.Добавить();
                НоваяСтрока.Сторона = Контрагент;
            КонецЕсли;
        КонецЕсли;
    ИначеЕсли ВидДокументаОбъект.ВестиУчетПоКонтрагентам Тогда
        Если ЗначениеЗаполнено(Контрагент) Тогда
			ОбъектДО.Контрагент = Контрагент;
        КонецЕсли;
	КонецЕсли;
	
	//+Шерер Заполнение табличной части ФинансовыеШифры 
	Для Каждого стрФинансовыеШифры ИЗ Объект.ФинансовыеШифры Цикл
		Если ЗначениеЗаполнено(стрФинансовыеШифры.ФинансовыйШифр) Тогда 
			новСтр = ОбъектДО.аск_сод_ФинансовыеШифры.Добавить();
			ЗаполнитьЗначенияСвойств(новСтр,стрФинансовыеШифры);
		КонецЕсли;
	КонецЦикла;
	//-Шерер Заполнение табличной части ФинансовыеШифры 
	
	//+Шерер Исключаю проверки, которые выполняются только при ручном редактировании документа
	ОбъектДО.ОбменДанными.Загрузка = Истина;
	//ОбъектДО.ДополнительныеСвойства.Вставить(ЗагрузкаДокументовСОД = Истина; // как оказалось не достаточно ОбменДанными.Загрузка. В процедуру ЗаписатьСвойстваУОбъекта передается ссылка
	//-Шерер Исключаю проверки, которые выполняются только при ручном редактировании документа
	
	ОбъектДО.Записать();
    ОбработкаЗапросовXDTOДокументы.ОбработатьДокументПослеЗаписи(
        ОбъектДО, Новый Структура("ТипИсточника"));

    Если ЗначениеЗаполнено(ПолныйПутьПапки) Тогда
        Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения
            .НайтиПоРеквизиту("Имя", "ЗагруженАвтоматически");
        Если ЗначениеЗаполнено(Свойство) Тогда
            ДанныеДопРеквизитов = Новый ТаблицаЗначений;
            ДанныеДопРеквизитов.Колонки.Добавить("Свойство");
            ДанныеДопРеквизитов.Колонки.Добавить("Значение");
            Строка = ДанныеДопРеквизитов.Добавить();
            Строка.Свойство = Свойство;
            Строка.Значение = ПолныйПутьПапки;
            УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(
                ОбъектДО.Ссылка, ДанныеДопРеквизитов);
        КонецЕсли;
    КонецЕсли;

    Если ОбработанныеПапки <> Неопределено Тогда
        ОбработанныеПапки.Вставить(ПолныйПутьПапки, ОбъектДО.Ссылка);
    КонецЕсли;
    Если ОтчетПоДокументам <> Неопределено Тогда
        ОтчетПоДокументам.НовыеДокументы.Добавить(ОбъектДО.Ссылка);
    КонецЕсли;
	ДобавитьРезультатЗагрузкиДокумента(ПолныйПутьПапки, "", СсылкаСтруктуры, ОбъектДО.Ссылка, _УСПЕХ_ , "");
    Возврат ОбъектДО.Ссылка;
	
КонецФункции 


// Выполняет непосредственное создание объекта "Файл" в справочнике "Файлы",
// привязку его к документу, установку роли файла и запись дополнительных реквизитов.
//
// Параметры:
//  ПутьФайла - Строка - полный путь к файлу на диске;
//  ДвоичныеДанные - ДвоичныеДанные - содержимое файла;
//  СсылкаНаДокумент - СправочникСсылка.ДокументыПредприятия - документ-владелец файла;
//  ИмяПапки - Строка - имя папки, из которой загружен файл (для определения роли);
//  ОтчетПоДокументам - Структура - структура для сбора статистики и ошибок;
//  РезультатПрикрепления - Структура - структура для возврата счетчиков загруженных, пропущенных и существовавших файлов.
//
&НаСервере
Процедура ПрикрепитьФайлКДокументу(ПутьФайла, ДвоичныеДанные, СсылкаНаДокумент, ИмяПапки, ОтчетПоДокументам,РезультатПрикрепления)
	//+Шерер: Перенёс рассчет имени и расширения в начало, что бы корректно добавлять в ТЧ Результат...
	//Кусок от кода СунцовойЕ.
	//ОбъектФайла используется для автоматического разбора ПутьФайла на состовляющие 
    ОбъектФайла = Новый Файл(ПутьФайла);
	Расширение = ОбъектФайла.Расширение; 
    Если Лев(Расширение, 1) = "." Тогда
        Расширение = Сред(Расширение, 2);
    КонецЕсли;
    ИмяФайла = ОбъектФайла.ИмяБезРасширения;
	//+Шерер Перенёс рассчет имени и расширения в начало, что бы корректно добавлять в ТЧ Результат...
	
	Если НЕ ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		ОтчетПоДокументам.ОшибкиФайлов.Добавить("Не загружен: " + ПутьФайла);
РезультатПрикрепления.НеЗагружено = РезультатПрикрепления.НеЗагружено + 1;
		ДобавитьРезультатЗагрузкиФайла(ОбъектФайла.Путь, ИмяФайла+"."+Расширение, "ПравилоЗагрузки", Неопределено, _БЕДА_
			, "Не указан документ предприятия");
Возврат;
    КонецЕсли;

    Если НЕ ЗначениеЗаполнено(ПутьФайла) Тогда
        ОтчетПоДокументам.ОшибкиФайлов.Добавить(
            "Пустой путь к файлу: ");
РезультатПрикрепления.НеЗагружено = РезультатПрикрепления.НеЗагружено + 1;
		ДобавитьРезультатЗагрузкиФайла(ОбъектФайла.Путь, ИмяФайла+"."+Расширение, "ПравилоЗагрузки", Неопределено, _БЕДА_
			, "Пустой путь к файлу");
        Возврат;
    КонецЕсли;

    Если СсылкаНаДокумент.ПометкаУдаления Тогда
        ОтчетПоДокументам.ОшибкиФайлов.Добавить(
            "Документ помечен на удаление: " + СсылкаНаДокумент); 
РезультатПрикрепления.НеЗагружено = РезультатПрикрепления.НеЗагружено + 1;
		ДобавитьРезультатЗагрузкиФайла(ОбъектФайла.Путь, ИмяФайла+"."+Расширение, "ПравилоЗагрузки", Неопределено, _БЕДА_
			, "Документ помечен на удаление");
        Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяПапки) Тогда
		РольФайла = Справочники.РолиФайлов.НайтиПоНаименованию(ИмяПапки, Истина);  
		Если НЕ ЗначениеЗаполнено(РольФайла) Тогда
			НовыйЭлемент = Справочники.РолиФайлов.СоздатьЭлемент();
			НовыйЭлемент.Наименование = ИмяПапки;
			НовыйЭлемент.Записать();
			РольФайла = НовыйЭлемент.Ссылка;
		КонецЕсли;

	КонецЕсли;	
	//СуществующийФайл = НайтиСуществующийФайл(СсылкаНаДокумент, ПутьФайла);
	//Если СуществующийФайл <> Неопределено Тогда
	//    РезультатПрикрепления.НеЗагружено = РезультатПрикрепления.НеЗагружено + 1;
	//    Возврат;
	//КонецЕсли; 
	
	СуществующийФайл = НайтиСуществующийФайл(СсылкаНаДокумент, ПутьФайла);
	Если СуществующийФайл <> Неопределено Тогда
		РезультатПрикрепления.Существовало = РезультатПрикрепления.Существовало + 1; 
		ДобавитьРезультатЗагрузкиФайла(ОбъектФайла.Путь, ИмяФайла+"."+Расширение, "ПравилоЗагрузки", СуществующийФайл, _РАНЕЕ_, "");
		Возврат;
	КонецЕсли;

	//ОбъектФайла = Новый Файл(ПутьФайла);
	//
	//Расширение = ОбъектФайла.Расширение; 
	//
	//Если Лев(Расширение, 1) = "." Тогда
	//    Расширение = Сред(Расширение, 2);
	//КонецЕсли;
	//ИмяФайла = ОбъектФайла.ИмяБезРас	
	
	Если НЕ ЗначениеЗаполнено(Расширение) Тогда
        ОтчетПоДокументам.ОшибкиФайлов.Добавить(
            "Не удалось определить расширение: " + ПутьФайла);
РезультатПрикрепления.НеЗагружено = РезультатПрикрепления.НеЗагружено + 1;
		ДобавитьРезультатЗагрузкиФайла(ОбъектФайла.Путь, ИмяФайла+"."+Расширение, "ПравилоЗагрузки", СуществующийФайл, _БЕДА_
			, "Не удалось определить расширение");
        Возврат;
    КонецЕсли;

    Если НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
        ОтчетПоДокументам.ОшибкиФайлов.Добавить(
            "Пустое имя файла: " + ПутьФайла);
РезультатПрикрепления.НеЗагружено = РезультатПрикрепления.НеЗагружено + 1;
		ДобавитьРезультатЗагрузкиФайла(ОбъектФайла.Путь, ИмяФайла+"."+Расширение, "ПравилоЗагрузки", СуществующийФайл, _БЕДА_
			, "Пустое имя файла");
        Возврат;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |    Файлы.Ссылка
        |ИЗ
        |    Справочник.Файлы КАК Файлы
        |ГДЕ
        |    Файлы.ВладелецФайла = &Владелец
        |    И Файлы.Наименование = &Наименование
        |    И НЕ Файлы.ПометкаУдаления";

    Запрос.УстановитьПараметр("Владелец",     СсылкаНаДокумент);
    Запрос.УстановитьПараметр("Наименование", ИмяФайла); 
	
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		ПутьПапкиФайла = ОбъектФайла.Путь;
		Если Прав(ПутьПапкиФайла, 1) = "\" Тогда
        ПутьПапкиФайла = Лев(ПутьПапкиФайла, СтрДлина(ПутьПапкиФайла) - 1);
    КонецЕсли;
		 
		РодительскаяПапка = Новый Файл(ПутьПапкиФайла);
        ИмяФайла = ИмяФайла + " (" + РодительскаяПапка.Имя + ")";
        Запрос.УстановитьПараметр("Наименование", ИмяФайла);
		Если НЕ Запрос.Выполнить().Пустой() Тогда
			ОтчетПоДокументам.ОшибкиФайлов.Добавить("Не загружен: " + ПутьФайла);
			РезультатПрикрепления.НеЗагружено = РезультатПрикрепления.НеЗагружено + 1;
			ДобавитьРезультатЗагрузкиФайла(ОбъектФайла.Путь, ИмяФайла+"."+Расширение, "ПравилоЗагрузки", СуществующийФайл, _РАНЕЕ_, "");
			Возврат;
        КонецЕсли;
    КонецЕсли;
	
	
	
	АдресВХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		
    ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
    ПараметрыФайла.ИмяБезРасширения = ИмяФайла;
    ПараметрыФайла.РасширениеБезТочки = Расширение;
    ПараметрыФайла.ВладелецФайлов = СсылкаНаДокумент;
	ПараметрыФайла.ГруппаФайлов = РольФайла;
    НовыйФайл = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресВХранилище);

	УдалитьИзВременногоХранилища(АдресВХранилище);
		
	Если НовыйФайл <> Неопределено И ЗначениеЗаполнено(НовыйФайл) Тогда 
		
		//Запись в регистр для прикрепления файла к РолиФайла 
		Если ЗначениеЗаполнено(РольФайла)Тогда
			НаборЗаписей = РегистрыСведений.РолиФайловДокументов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Файл.Установить(НовыйФайл);
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.Файл = НовыйФайл;
			НоваяЗапись.Роль = РольФайла;
			НаборЗаписей.Записать();
		КонецЕсли;
		//Запись в регистр для прикрепления файла к РолиФайла
		
		Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения
		.НайтиПоРеквизиту("Имя", "ЗагруженАвтоматически");
		Если ЗначениеЗаполнено(Свойство) Тогда
            ДанныеДопРеквизитов = Новый ТаблицаЗначений;
            ДанныеДопРеквизитов.Колонки.Добавить("Свойство");
            ДанныеДопРеквизитов.Колонки.Добавить("Значение");
            Строка          = ДанныеДопРеквизитов.Добавить();
            Строка.Свойство = Свойство;
            Строка.Значение = ПутьФайла;
            УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(
                НовыйФайл, ДанныеДопРеквизитов);
        КонецЕсли;
        РезультатПрикрепления.Загружено = РезультатПрикрепления.Загружено + 1;
		
		ДобавитьРезультатЗагрузкиФайла(ОбъектФайла.Путь, ИмяФайла+"."+Расширение, "ПравилоЗагрузки", НовыйФайл, _УСПЕХ_, "");
   Иначе
        ОтчетПоДокументам.ОшибкиФайлов.Добавить(
            "Не удалось добавить файл: " + ОбъектФайла.Путь);
РезультатПрикрепления.НеЗагружено = РезультатПрикрепления.НеЗагружено + 1;
    КонецЕсли;
	
	
КонецПроцедуры

// Формирует табличный документ с итоговой статистикой по загрузке документов и файлов,
// включая списки возникших ошибок.
//
// Параметры:
//  Статистика - Структура - структура с накопленной статистикой и массивами ошибок.
//
// Возвращаемое значение:
//  ТабличныйДокумент - сформированный табличный документ с отчетом.
//
&НаСервере
Функция СформироватьОтчёт(Статистика)
	
	//+Шерер
	Статистика.ВсегоФайлов = ЭтаФорма.ВсегоФайлов; //Устанавливаю количество файлов на расчитанное при ообходе каталога, что бы не было примеси алгоритма обрботки папок
	
	ЭтаФорма.ВремяОкончанияЗагрузки = ТекущаяДатаСеанса();

	ЭтаФорма.ТабДок.Очистить();
	ОтчетТабДок = ЭтаФорма.ТабДок;

	//ОтчётТабДок = Новый ТабличныйДокумент;
	//-Шерер
	
	ВывестиСтроку(ОтчетТабДок, "Всего файлов в папках",
	Статистика.ВсегоФайлов, Истина);
	ВывестиСтроку(ОтчетТабДок, "Файлов загружено",
	Статистика.ФайловЗагружено, Ложь); 
	ВывестиСтроку(ОтчетТабДок, "Файлов существовало (уже загружены ранее)",  
    Статистика.ФайловСуществовало, Ложь);
	ВывестиСтроку(ОтчетТабДок, "Файлов не загружено (дубликаты/ошибки)",
	Статистика.ФайловПропущено, Ложь); 
	
	ВывестиСтроку(ОтчетТабДок, "", Неопределено, Ложь); 
	
	
	ВывестиСтроку(ОтчетТабДок, "Новых документов загружено",
	Статистика.НовыеДокументы.Количество(), Ложь);
	ВывестиСтроку(ОтчетТабДок, "Документов уже существовало",
	Статистика.СуществующиеДокументы.Количество(), Ложь);
	
	Если Статистика.ОшибкиДокументов.Количество() > 0 Тогда
		ВывестиСтроку(ОтчетТабДок, "", Неопределено, Ложь);
		ВывестиСтроку(ОтчетТабДок,
		"ОШИБКИ ПРИ СОЗДАНИИ ДОКУМЕНТОВ ("
		+ Статистика.ОшибкиДокументов.Количество() + ")",
		Неопределено, Истина);
		
		Для Инд = 0 По Статистика.ОшибкиДокументов.ВГраница() Цикл
			ТекстОшибки  = Статистика.ОшибкиДокументов[Инд];
			СсылкаОшибки = Статистика.СсылкиОшибокДокументов[Инд];
			Если ЗначениеЗаполнено(СсылкаОшибки) Тогда
				ВывестиСтрокуСоСсылкой(ОтчетТабДок, ТекстОшибки, СсылкаОшибки);
			Иначе
				ВывестиСтроку(ОтчетТабДок, ТекстОшибки, Неопределено, Ложь);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Статистика.ОшибкиФайлов.Количество() > 0 Тогда
		ВывестиСтроку(ОтчетТабДок, "", Неопределено, Ложь);
		ВывестиСтроку(ОтчетТабДок,
		"ОШИБКИ ПРИКРЕПЛЕНИЯ ФАЙЛОВ ("
		+ Статистика.ОшибкиФайлов.Количество() + ")",
		Неопределено, Истина);
		Для Каждого Ошибка Из Статистика.ОшибкиФайлов Цикл
			ВывестиСтроку(ОтчетТабДок, Ошибка, Неопределено, Ложь);
		КонецЦикла;
	КонецЕсли;
	
	//+Шерер
	НовОтчет = Справочники.аск_сод_ОтчетыЗагрузкиДанных.СоздатьЭлемент();
	ЗаполнитьЗначенияСвойств(НовОтчет,Объект);
	ЗаполнитьЗначенияСвойств(НовОтчет,ЭтаФорма);
	НовОтчет.ТабличныйДокумент = ЗначениеВСтрокуВнутр(ЭтаФорма.ТабДок);
	НовОтчет.Пользователь = Пользователи.ТекущийПользователь();
	
	НовОтчет.Наименование = "Загрузка "+ Формат(ЭтаФорма.ВремяНачалаЗагрузки,"ДЛФ=DT") + " - " + Формат(ЭтаФорма.ВремяОкончанияЗагрузки,"ДЛФ=DT");
	
	Для Каждого стрРезультат из Объект.РезультатыЗагрузкиДокументов Цикл
		НовСтрРезультат =  НовОтчет.РезультатыЗагрузкиДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрРезультат,стрРезультат);
	КонецЦикла;
	
	Для Каждого стрРезультат из Объект.РезультатыЗагрузкиФайлов Цикл
		НовСтрРезультат =  НовОтчет.РезультатыЗагрузкиФайлов.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрРезультат,стрРезультат);
	КонецЦикла;

	Для Каждого стрРезультат из Объект.ФайлыВсего Цикл
		НовСтрРезультат =  НовОтчет.ФайлыВсего.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрРезультат,стрРезультат);
	КонецЦикла;
	
	Для Каждого стрФинШифрыСохраненные из Объект.ФинансовыеШифры Цикл 
		новСтр = НовОтчет.ФинансовыеШифры.Добавить();
		ЗаполнитьЗначенияСвойств(новСтр,стрФинШифрыСохраненные);
	КонецЦикла;
	
	НовОтчет.Записать();
	//-Шерер

	Возврат ОтчетТабДок;
	
КонецФункции

// Выводит одну строку в табличный документ отчета, состоящую из текстового описания и числового значения.
//
// Параметры:
//  ОтчётТабДок - ТабличныйДокумент - табличный документ, в который выполняется вывод;
//  Текст - Строка - текстовое описание показателя;
//  Значение - Число, Строка, Неопределено - числовое или текстовое значение показателя;
//  Жирный - Булево - признак необходимости вывода текста жирным шрифтом.
//
&НаСервере
Процедура ВывестиСтроку(ОтчётТабДок, Текст, Значение = "", Жирный = Ложь)
	
    НомерСтроки = ОтчётТабДок.ВысотаТаблицы + 1;
    Яч1 = ОтчётТабДок.Область(НомерСтроки, 1);
    Яч1.Текст         = Текст;
    Яч1.Шрифт         = Новый Шрифт(, , Жирный);
    Яч1.ШиринаКолонки = 80;
    Если Значение <> Неопределено Тогда
        Яч2 = ОтчётТабДок.Область(НомерСтроки, 2);
        Яч2.Текст         = "" + Значение;
        Яч2.Шрифт         = Новый Шрифт(, , Жирный);
        Яч2.ШиринаКолонки = 20;
	КонецЕсли;
	
КонецПроцедуры  

// Выводит строку в табличный документ отчета, содержащую текст ошибки и гиперссылку
// на элемент справочника "Структура каталога".
//
// Параметры:
//  ОтчётТабДок - ТабличныйДокумент - табличный документ для вывода;
//  Текст - Строка - текст ошибки или описания;
//  СсылкаСтруктураКаталога - СправочникСсылка.СтруктураКаталога - ссылка на элемент справочника для формирования гиперссылки.
//
&НаСервере
Процедура ВывестиСтрокуСоСсылкой(ОтчётТабДок, Текст, СсылкаСтруктураКаталога)
	
    НомерСтроки = ОтчётТабДок.ВысотаТаблицы + 1;

    Яч1 = ОтчётТабДок.Область(НомерСтроки, 1);
    Яч1.Текст         = Текст;
    Яч1.Шрифт         = Новый Шрифт(, , Ложь);
    Яч1.ШиринаКолонки = 80;

    Яч2 = ОтчётТабДок.Область(НомерСтроки, 2);
    Яч2.Текст         = СсылкаСтруктураКаталога.Наименование; 
    Яч2.Расшифровка   = СсылкаСтруктураКаталога;              
    Яч2.ЦветТекста    = WebЦвета.Синий;
    Яч2.Шрифт         = Новый Шрифт(, , Ложь, , Истина, Ложь); 
    Яч2.ШиринаКолонки = 40;
	
КонецПроцедуры

// Выполняет поиск ранее загруженного документа в справочнике "Документы предприятия"
// по виду документа, проекту, организации и пути к папке, сохраненному в дополнительном реквизите.
//
// Параметры:
//  ВидДокумента - СправочникСсылка.ВидыДокументов - вид документа для поиска;
//  Проект - СправочникСсылка.Проекты - проект для поиска;
//  Организация - СправочникСсылка.Организации - организация для поиска;
//  ПолныйПутьПапки - Строка - путь к папке, сохраненный в доп. реквизите "ЗагруженАвтоматически".
//
// Возвращаемое значение:
//  СправочникСсылка.ДокументыПредприятия, Неопределено - ссылка на найденный документ или Неопределено, если документ не найден.
//
&НаСервере
Функция НайтиСуществующийДокумент(ВидДокумента, Проект, Организация, ПолныйПутьПапки)

	Если НЕ ЗначениеЗаполнено(ПолныйПутьПапки) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения
        .НайтиПоРеквизиту("Имя", "ЗагруженАвтоматически");
    Если НЕ ЗначениеЗаполнено(Свойство) Тогда
         Возврат Неопределено;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    ДО.Ссылка
    |ИЗ
    |    Справочник.ДокументыПредприятия КАК ДО
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ
    |            Справочник.ДокументыПредприятия.ДополнительныеРеквизиты КАК ДР
    |        ПО  ДР.Ссылка   = ДО.Ссылка
    |        И   ДР.Свойство = &Свойство
    |        И   ВЫРАЗИТЬ(ДР.Значение КАК Строка(1000)) = &Путь
    |ГДЕ
    |    НЕ ДО.ПометкаУдаления
	//|    И ДО.ВидДокумента = &ВидДокумента
	//|    И ДО.Проект       = &Проект
	//|    И ДО.Организация  = &Организация
    |";

    Запрос.УстановитьПараметр("Свойство",     Свойство);
    Запрос.УстановитьПараметр("Путь",         ПолныйПутьПапки);
	//Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
	//Запрос.УстановитьПараметр("Проект",       Проект);
	//Запрос.УстановитьПараметр("Организация",  Организация);
	
	
	Результат = Запрос.Выполнить();
    Если Результат.Пустой() Тогда
        Возврат Неопределено;
    КонецЕсли;

    Выборка = Результат.Выбрать();
    Выборка.Следующий();
    Возврат Выборка.Ссылка;
КонецФункции 

// Выполняет обработку одной папки на сервере: определяет соответствие папки элементу справочника
// "Структура каталога", создает документы (один на папку или на каждый файл) и формирует список
// файлов для последующего прикрепления.
//
// Параметры:
//  ОписаниеПапки - Структура - структура с описанием обрабатываемой папки и списками файлов.
//
// Возвращаемое значение:
//  Структура - структура с отчетом по результатам обработки папки (статистика, ошибки, файлы для прикрепления).
//
&НаСервере
Функция ОбработатьПапкуНаСервере(ОписаниеПапки)
	
	Если ОписаниеПапки.Файлы.Количество() = 0 Тогда 
		Возврат Неопределено; // функция должна вызываться только в случае наличия файлов этой папке и вложенных
	КонецЕсли;
	
	Проект      = Объект.Проект;
    Организация = Объект.Организация;
	ФайлыСГруппами = ОписаниеПапки.ФайлыСГруппами;
    КонтрагентДляЗагрузки = Объект.Контрагент; //Справочники.Контрагенты.НайтиПоНаименованию("ТЕСТ", Истина);
	//Если НЕ ЗначениеЗаполнено(КонтрагентДляЗагрузки) Тогда
	//    Сообщить("Контрагент не найден!", СтатусСообщения.Важное);
	//    Возврат Неопределено;
	//КонецЕсли;

    ОтчетПоДокументам = Новый Структура;
    ОтчетПоДокументам.Вставить("НовыеДокументы",         Новый Массив);
    ОтчетПоДокументам.Вставить("СуществующиеДокументы",  Новый Массив);
    ОтчетПоДокументам.Вставить("ОшибкиДокументов",       Новый Массив);
    ОтчетПоДокументам.Вставить("ОшибкиФайлов",           Новый Массив);
    ОтчетПоДокументам.Вставить("СсылкиОшибокДокументов", Новый Массив);
    ОтчетПоДокументам.Вставить("ВсегоФайлов",            0);
    ОтчетПоДокументам.Вставить("ФайловЗагружено",        0);
    ОтчетПоДокументам.Вставить("ФайловПропущено",        0);
    ОтчетПоДокументам.Вставить("ФайловСуществовало",     0);
	ОтчетПоДокументам.Вставить("ФайлыДляПрикрепления", Новый Соответствие);

    ОбработанныеПапки     = Новый Соответствие;
    ИмяПапкиНРег          = ОписаниеПапки.ИмяПапки;
    ПолноеИмяПапки        = ОписаниеПапки.ПолноеИмяПапки;
    ФайлыПапки            = ОписаниеПапки.Файлы; // Список файлов этой папки и вложенных
    ФайлыТолькоЭтойПапки  = ОписаниеПапки.ФайлыТолькоЭтойПапки;  // Список файлов этой папки без вложенных
    РодительскоеПолноеИмя = ОписаниеПапки.РодительскоеПолноеИмя;

    СоответствиеСтруктур = Новый Соответствие;
    ЗаполнитьСоответствиеСтруктурКаталога(
	Справочники.аск_сод_СтруктураКаталогаЗагрузки.ПустаяСсылка(),
        СоответствиеСтруктур);

    ДанныеСтруктуры = Неопределено;
    КаталогПроекта  = СокрЛП(Объект.КаталогПроекта);
    Если Прав(КаталогПроекта, 1) = "\" Тогда
        КаталогПроекта = Лев(КаталогПроекта, СтрДлина(КаталогПроекта) - 1);
    КонецЕсли;
	
	//1. Не важно найдена текущая папка в справочнике структура каталога или нет нужно изначально проверить возмжно РодительУжеОбрабатывает 
	#Область Определение_РодительУжеОбрабатывает
	РодительУжеОбрабатывает = Ложь;
	
	//+Шерер&QWEN: Исправлена логическая ошибка "Отсутвие проверки по цепочке для определения РодительУжеОбрабатывает". 
	// Теперь проверяются ВСЕ предки по цепочке вверх, а не только непосредственный родитель.
	// Это гарантирует, что если где-то выше есть папка со способом загрузки "СоздатьДокумент...", она корректно перехватит файлы.
	ОтносительныйПутьТекущей = Сред(ПолноеИмяПапки, СтрДлина(КаталогПроекта) + 2);
	ОтносительныйПутьТекущей = СтрЗаменить(ОтносительныйПутьТекущей, "/", "\");
	
	Если ЗначениеЗаполнено(ОтносительныйПутьТекущей) Тогда
		ПозицияСлеша = СтрНайти(ОтносительныйПутьТекущей, "\", НаправлениеПоиска.СКонца);
		Пока ПозицияСлеша > 0 Цикл
			ОтносительныйПутьПредка = Лев(ОтносительныйПутьТекущей, ПозицияСлеша - 1);
			ПутьПредкаНРег = НРег(СокрЛП(ОтносительныйПутьПредка));
			
			ДанныеПредка = СоответствиеСтруктур[ПутьПредкаНРег];
			Если ДанныеПредка <> Неопределено Тогда
				Если ДанныеПредка.СпособЗагрузкиИзКаталога = Перечисления.СпособыЗагрузкиИзКаталога.СоздатьДокументИЗагрузитьФайлы
				 ИЛИ ДанныеПредка.СпособЗагрузкиИзКаталога = Перечисления.СпособыЗагрузкиИзКаталога.СоздатьДокументИЗагрузитьФайлы_БезРоли 
				Тогда
					
					// РОДИТЕЛЬ УЖЕ ОБРАБАТЫВАЕТ ФАЙЛЫ РЕКУРСИВНО
					// Пропускаем обработку текущей папки, чтобы не создавать дублирующийся документ
					РодительУжеОбрабатывает = Истина;
					
					// Возвращаем пустой отчёт - текущая папка не обрабатывается
					Возврат ОтчетПоДокументам;
					
				ИначеЕсли ДанныеПредка.СпособЗагрузкиИзКаталога = Перечисления.СпособыЗагрузкиИзКаталога.ДляКаждогоФайлаСоздатьДокумент Тогда
					// Для этого способа нужна другая логика - каждый файл создаёт свой документ
					РодительУжеОбрабатывает = Истина;
					
					// Вроде как, все документы были загруженны при обработке предка, поэтом прерываю обработку текущей папки.
					Возврат ОтчетПоДокументам;
					
					//ДанныеСтруктуры = ДанныеПредка;
					//Прервать;
				КонецЕсли;
			КонецЕсли;
			
			// Идем на уровень выше по иерархии
			ПозицияСлеша = СтрНайти(ОтносительныйПутьПредка, "\", НаправлениеПоиска.СКонца);
		КонецЦикла;
	КонецЕсли;
	//Если ЗначениеЗаполнено(РодительскоеПолноеИмя) Тогда
	//	ЧастиПути = СтрРазделить(РодительскоеПолноеИмя, "\");
	//	РодительскоеИмяНРег = НРег(СокрЛП(
	//	    ЧастиПути[ЧастиПути.ВГраница()]));
	//	ДанныеРодителя = СоответствиеСтруктур[РодительскоеИмяНРег];
	//	Если ДанныеРодителя <> Неопределено Тогда
	//	    Если ДанныеРодителя.СпособЗагрузкиИзКаталога = Перечисления.СпособыЗагрузкиИзКаталога.СоздатьДокументИЗагрузитьФайлы
	//	     ИЛИ ДанныеРодителя.СпособЗагрузкиИзКаталога = Перечисления.СпособыЗагрузкиИзКаталога.СоздатьДокументИЗагрузитьФайлы_БезРоли 
	//	     ИЛИ ДанныеРодителя.СпособЗагрузкиИзКаталога = Перечисления.СпособыЗагрузкиИзКаталога.ДляКаждогоФайлаСоздатьДокумент 
	//	Тогда
	//	        РодительУжеОбрабатывает = Истина;
	//	    КонецЕсли;
	//	КонецЕсли;
	//КонецЕсли;
	//-Шерер&QWEN: Исправлена логическая ошибка "Отсутвие проверки по цепочке для определения РодительУжеОбрабатывает". 
	#КонецОбласти
	
	//2. поиск правила обработкки каталога, только если НЕ РодительУжеОбрабатывает
	#Область Определение_РодительУжеОбрабатывает
	//+Шерер старый код заменил на новый с учетом поиска для загрузки из локальной папки.
	//Спасибо QWEN за подсказку))
	//Если СтрНачинаетсяС(ПолноеИмяПапки, КаталогПроекта) Тогда 
	//// тупая проверка, как может появиться папка не из каталога загрузки, (ИИ-шка перестраховывается)
	//    //1. определение Путиобрабатываемой папки относительно каталога загрузки
	//    ОтносительныйПуть = Сред(ПолноеИмяПапки, СтрДлина(КаталогПроекта) + 2);
	//    ОтносительныйПуть = СтрЗаменить(ОтносительныйПуть, "/", "\");
	//    КлючПоПути = НРег(СокрЛП(ОтносительныйПуть));
	//    ДанныеСтруктуры = СоответствиеСтруктур[КлючПоПути];
	//КонецЕсли;
    //
	//++Шерер: Вредоносный код, поиск папки по короткому пути. Закоментировал!!!
	//Если ДанныеСтруктуры = Неопределено Тогда
	//    ДанныеСтруктуры = СоответствиеСтруктур[ИмяПапкиНРег];
	//КонецЕсли;
	//--Шерер: Вредоносный код, поиск папки по короткому пути. Закоментировал!!!
	Если НЕ РодительУжеОбрабатывает Тогда
        // Строгий поиск по префиксу полного пути.
        // Мы ищем элемент справочника, полный путь которого является окончанием 
        // реального пути на диске. Это гарантирует выбор правильного элемента 
        // иерархии и полностью исключает выбор "мусора" из параллельных веток.
		ОтносительноеИмяПапки = Сред(ПолноеИмяПапки,СтрДлина(КаталогПроекта)+2);
		ОтносительноеИмяПапки_НРег = НРег(СокрЛП(ОтносительноеИмяПапки));
        
        Для Каждого КлючИЗначение Из СоответствиеСтруктур Цикл
            ПутьСправочника_НРег = НРег(СокрЛП(КлючИЗначение.Значение.ПолныйПутьККаталогу));
            Если ПутьСправочника_НРег = ОтносительноеИмяПапки_НРег Тогда
            	ДанныеСтруктуры = КлючИЗначение.Значение;
				Прервать; //Наличие других - ошибка заполнения справочника "СтруктураКаталога"
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;	
	//-Шерер: старый код заменил на новый с учетом поиска для загрузки из локальной папки
	
	#КонецОбласти
	
	//3.Проверка на наличие правила обработки папки, наличие элемента справочника "СтруктураКаталога
	#Область Определение_РодительУжеОбрабатывает
	Если ДанныеСтруктуры = Неопределено Тогда
		Если ФайлыТолькоЭтойПапки.Количество() > 0 Тогда
			
            Если НЕ РодительУжеОбрабатывает Тогда
                ОтчетПоДокументам.ОшибкиДокументов.Добавить(
                    "Папка не найдена в справочнике 'Структура каталога загрузки', "
                    + "файлы не загружены: " + ПолноеИмяПапки);
                ОтчетПоДокументам.СсылкиОшибокДокументов.Добавить(Неопределено);
				Для Каждого ПутьФайла Из ФайлыТолькоЭтойПапки Цикл
        		ОтчетПоДокументам.ОшибкиФайлов.Добавить("Не загружен: " + ПутьФайла);
			    //+Шерер
				ОтносительныйПутьКФайлу = ПутьФайла;
				ИмяФайлаСРасширением = Сред(ПутьФайла,СтрНайти(ПутьФайла,"\",НаправлениеПоиска.СКонца)+1);
				ОтносительныйПутьКФайлу = Лев(ПутьФайла,СтрНайти(ПутьФайла,"\",НаправлениеПоиска.СКонца)-1);
				ДобавитьРезультатЗагрузкиФайла(ПутьФайла, ИмяФайлаСРасширением, "ПравилоЗагрузки", Неопределено, _БЕДА_
					, "Папка не найдена в справочнике 'СтруктураКаталога'"
				);
			    //-Шерер
    			КонецЦикла;
                ОтчетПоДокументам.ВсегоФайлов = ОтчетПоДокументам.ВсегоФайлов
                    + ФайлыТолькоЭтойПапки.Количество();
                ОтчетПоДокументам.ФайловПропущено = ОтчетПоДокументам.ФайловПропущено
                    + ФайлыТолькоЭтойПапки.Количество();
            КонецЕсли;
        КонецЕсли;
        Возврат ОтчетПоДокументам;
    КонецЕсли;
	#КонецОбласти

	//4.ВидОбработки СмотретьДалее
	#Область СмотретьДалее
	Если ДанныеСтруктуры.СпособЗагрузкиИзКаталога
            = Перечисления.СпособыЗагрузкиИзКаталога.СмотретьДалее Тогда
        Если ФайлыТолькоЭтойПапки.Количество() > 0 Тогда
            ОтчетПоДокументам.ОшибкиДокументов.Добавить(
                "Файлы лежат в папке со способом 'Смотреть далее', "
                + "загрузка невозможна: " + ПолноеИмяПапки);
            ОтчетПоДокументам.СсылкиОшибокДокументов.Добавить(Неопределено); 
			Для Каждого ПутьФайла Из ФайлыТолькоЭтойПапки Цикл
    		ОтчетПоДокументам.ОшибкиФайлов.Добавить("Не загружен: " + ПутьФайла);
			    //+Шерер
				ОтносительныйПутьКФайлу = ПутьФайла;
				ИмяФайлаСРасширением = Сред(ПутьФайла,СтрНайти(ПутьФайла,"\",НаправлениеПоиска.СКонца)+1);
				ОтносительныйПутьКФайлу = Лев(ПутьФайла,СтрНайти(ПутьФайла,"\",НаправлениеПоиска.СКонца)-1);
				ДобавитьРезультатЗагрузкиФайла(ПутьФайла, ИмяФайлаСРасширением, ДанныеСтруктуры.Ссылка, Неопределено, _БЕДА_
					, "Файл лежит в папке со способом 'Смотреть далее'");
				//-Шерер
			КонецЦикла;
            ОтчетПоДокументам.ВсегоФайлов = ОтчетПоДокументам.ВсегоФайлов
                + ФайлыТолькоЭтойПапки.Количество();
            ОтчетПоДокументам.ФайловПропущено = ОтчетПоДокументам.ФайловПропущено
                + ФайлыТолькоЭтойПапки.Количество();
        КонецЕсли;
        Возврат ОтчетПоДокументам;
    КонецЕсли;
	#КонецОбласти

	//5.Проверка, что заполнен ВидДокумента
	#Область ПроверкаДля_ВидДокумента
	Если НЕ ЗначениеЗаполнено(ДанныеСтруктуры.ВидДокумента) Тогда
    	//+Шерер: Используем все файлы (включая вложенные) для корректного баланса   ← ИЗМЕНЕНО
        Если ФайлыПапки.Количество() > 0 Тогда
    	//-Шерер: Используем все файлы (включая вложенные) для корректного баланса   ← ИЗМЕНЕНО
            ТекстОшибки = "Не заполнен ВидДокумента. Папка: [" + ПолноеИмяПапки + "]"
                + " | СтруктураКаталога: [" + ДанныеСтруктуры.Ссылка.Наименование
                + " | Путь: " + СокрЛП(ДанныеСтруктуры.Ссылка.ПолныйПутьККаталогу) + "]";
            ОтчетПоДокументам.ОшибкиДокументов.Добавить(ТекстОшибки);
            ОтчетПоДокументам.СсылкиОшибокДокументов.Добавить(ДанныеСтруктуры.Ссылка);
			Для Каждого ПутьФайла Из ФайлыПапки Цикл
   			 ОтчетПоДокументам.ОшибкиФайлов.Добавить("Не загружен: " + ПутьФайла);
			    //+Шерер
				ОтносительныйПутьКФайлу = ПутьФайла;
				ИмяФайлаСРасширением = Сред(ПутьФайла,СтрНайти(ПутьФайла,"\",НаправлениеПоиска.СКонца)+1);
				ОтносительныйПутьКФайлу = Лев(ПутьФайла,СтрНайти(ПутьФайла,"\",НаправлениеПоиска.СКонца)-1);
				ДобавитьРезультатЗагрузкиФайла(ПутьФайла, ИмяФайлаСРасширением, ДанныеСтруктуры.Ссылка, Неопределено, _БЕДА_
					, "Не заполнен ВидДокумента"
				);
				//-Шерер
			КонецЦикла;
            ОтчетПоДокументам.ВсегоФайлов = ОтчетПоДокументам.ВсегоФайлов
                + ФайлыПапки.Количество();
            ОтчетПоДокументам.ФайловПропущено = ОтчетПоДокументам.ФайловПропущено
                + ФайлыПапки.Количество();
        КонецЕсли;
        Возврат ОтчетПоДокументам;
    КонецЕсли;
	#КонецОбласти

	//6.ВидОбработки СоздатьДокументИЗагрузитьФайлы
	#Область СоздатьДокументИЗагрузитьФайлы
	
	Если ДанныеСтруктуры.СпособЗагрузкиИзКаталога <> Перечисления.СпособыЗагрузкиИзКаталога.СоздатьДокументИЗагрузитьФайлы
       И ДанныеСтруктуры.СпособЗагрузкиИзКаталога <> Перечисления.СпособыЗагрузкиИзКаталога.СоздатьДокументИЗагрузитьФайлы_БезРоли
       И ДанныеСтруктуры.СпособЗагрузкиИзКаталога <> Перечисления.СпособыЗагрузкиИзКаталога.ДляКаждогоФайлаСоздатьДокумент
	Тогда
        Если ФайлыТолькоЭтойПапки.Количество() > 0 Тогда
            ОтчетПоДокументам.ОшибкиДокументов.Добавить(
                "Неподдерживаемый способ загрузки ["
                + ДанныеСтруктуры.СпособЗагрузкиИзКаталога
                + "] для папки: " + ПолноеИмяПапки);
            ОтчетПоДокументам.СсылкиОшибокДокументов.Добавить(Неопределено); 
			Для Каждого ПутьФайла Из ФайлыТолькоЭтойПапки Цикл
    		ОтчетПоДокументам.ОшибкиФайлов.Добавить("Не загружен: " + ПутьФайла);
			    //+Шерер
				ОтносительныйПутьКФайлу = ПутьФайла;
				ИмяФайлаСРасширением = Сред(ПутьФайла,СтрНайти(ПутьФайла,"\",НаправлениеПоиска.СКонца)+1);
				ОтносительныйПутьКФайлу = Лев(ПутьФайла,СтрНайти(ПутьФайла,"\",НаправлениеПоиска.СКонца)-1);
				ДобавитьРезультатЗагрузкиФайла(ПутьФайла, ИмяФайлаСРасширением, ДанныеСтруктуры.Ссылка, Неопределено, _БЕДА_
					, "Неподдерживаемый способ загрузки ["+ ДанныеСтруктуры.СпособЗагрузкиИзКаталога+ "]"
				);
				//-Шерер
			КонецЦикла;
            ОтчетПоДокументам.ВсегоФайлов = ОтчетПоДокументам.ВсегоФайлов
                + ФайлыТолькоЭтойПапки.Количество();
            ОтчетПоДокументам.ФайловПропущено = ОтчетПоДокументам.ФайловПропущено
                + ФайлыТолькоЭтойПапки.Количество();
        КонецЕсли;
        Возврат ОтчетПоДокументам;
    КонецЕсли;
	
	ВсеФайлыДляДокумента = Новый Массив;
    УникальныеФайлы       = Новый Соответствие;
    Для Каждого ПутьФайла Из ФайлыПапки Цикл
        Если УникальныеФайлы[ПутьФайла] = Неопределено Тогда
            ВсеФайлыДляДокумента.Добавить(ПутьФайла);
            УникальныеФайлы.Вставить(ПутьФайла, Истина);
        КонецЕсли;
    КонецЦикла;

    Если ВсеФайлыДляДокумента.Количество() = 0 Тогда
        ОтчетПоДокументам.ОшибкиДокументов.Добавить(
            "Нет файлов для загрузки в папке: " + ПолноеИмяПапки);
        ОтчетПоДокументам.СсылкиОшибокДокументов.Добавить(Неопределено);
        Возврат ОтчетПоДокументам;
    КонецЕсли;
	#КонецОбласти

	//7.ВидОбработки СоздатьДокументИЗагрузитьФайлы
	#Область СоздатьДокументИЗагрузитьФайлы

    СпособЗагрузки = ДанныеСтруктуры.СпособЗагрузкиИзКаталога;
	
	Если СпособЗагрузки = Перечисления.СпособыЗагрузкиИзКаталога.СоздатьДокументИЗагрузитьФайлы
	 ИЛИ СпособЗагрузки = Перечисления.СпособыЗагрузкиИзКаталога.СоздатьДокументИЗагрузитьФайлы_БезРоли
	Тогда
				
			СоответствиеГрупп = Новый Соответствие;
			Для Каждого ОписФайла Из ФайлыСГруппами Цикл
				СоответствиеГрупп.Вставить(ОписФайла.ПутьФайла, ОписФайла.ИмяВложеннойПапки);
			КонецЦикла;
	
        СуществующийДок = НайтиСуществующийДокумент(
            ДанныеСтруктуры.ВидДокумента, Проект, Организация, ПолноеИмяПапки);

        Если СуществующийДок <> Неопределено Тогда
		   	//+Шерер
			ОтносительныйПутьКФайлу = ПолноеИмяПапки;
			ИмяФайлаСРасширением = Сред(ПутьФайла,СтрНайти(ПутьФайла,"\",НаправлениеПоиска.СКонца)+1);
			ОтносительныйПутьКФайлу = Лев(ПутьФайла,СтрНайти(ПутьФайла,"\",НаправлениеПоиска.СКонца)-1);
			ДобавитьРезультатЗагрузкиДокумента(ОтносительныйПутьКФайлу, ИмяФайлаСРасширением, ДанныеСтруктуры.Ссылка, СуществующийДок, _РАНЕЕ_ , "");
			//-Шерер

			ОбработанныеПапки.Вставить(ПолноеИмяПапки, СуществующийДок);
            ОтчетПоДокументам.СуществующиеДокументы.Добавить(СуществующийДок);
            СсылкаНаДокумент = СуществующийДок;
        Иначе
            СсылкаНаДокумент = СоздатьДокументСОД(
                ДанныеСтруктуры.ВидДокумента,
                Проект, Организация, КонтрагентДляЗагрузки,
                ПолноеИмяПапки,
                ОтчетПоДокументам,
                ОбработанныеПапки,
                Истина,
                ДанныеСтруктуры.Ссылка);		
        КонецЕсли;
	#КонецОбласти

	//8. Если документ создан, прикрепляем файлы, иначе ошибка
	#Область СмотретьДалее
		
		Если СсылкаНаДокумент <> Неопределено Тогда
            ОтчетПоДокументам.ВсегоФайлов = ОтчетПоДокументам.ВсегоФайлов
                + ВсеФайлыДляДокумента.Количество();
            РезультатПрикрепления = Новый Структура(
                "Загружено, НеЗагружено, Существовало", 0, 0, 0);
			Для Каждого ПутьФайла Из ВсеФайлыДляДокумента Цикл
								
				ИмяПапки = СоответствиеГрупп[ПутьФайла];
				ДанныеФайла = Новый Структура();
				ДанныеФайла.Вставить("СсылкаНаДокумент",СсылкаНаДокумент);
				
				Если СпособЗагрузки = Перечисления.СпособыЗагрузкиИзКаталога.СоздатьДокументИЗагрузитьФайлы Тогда
					ДанныеФайла.Вставить("ИмяПапки",?(ИмяПапки = Неопределено, "", ИмяПапки)); // Используется далее для определения роли файла
				Иначе //Если СпособЗагрузки = Перечисления.СпособыЗагрузкиИзКаталога.СоздатьДокументИЗагрузитьФайлы_БезРоли Тогда 
					ДанныеФайла.Вставить("ИмяПапки",Неопределено); // Используется далее для определения роли файла
				КонецЕсли;
				
				ОтчетПоДокументам.ФайлыДляПрикрепления.Вставить(ПутьФайла, ДанныеФайла);
				
				//ОтчетПоДокументам.ФайлыДляПрикрепления.Вставить(ПутьФайла, СсылкаНаДокумент);
			КонецЦикла; 
			 //ОтчетПоДокументам.ВсегоФайлов = ОтчетПоДокументам.ВсегоФайлов
				//+ ВсеФайлыДляДокумента.Количество();
			//ОтчетПоДокументам.ФайловЗагружено = ОтчетПоДокументам.ФайловЗагружено
			//    + РезультатПрикрепления.Загружено;
			//ОтчетПоДокументам.ФайловПропущено = ОтчетПоДокументам.ФайловПропущено
			//    + РезультатПрикрепления.НеЗагружено;
			//ОтчетПоДокументам.ФайловСуществовало = ОтчетПоДокументам.ФайловСуществовало
			//    + РезультатПрикрепления.Существовало;
        КонецЕсли;
		
	ИначеЕсли СпособЗагрузки = Перечисления.СпособыЗагрузкиИзКаталога.ДляКаждогоФайлаСоздатьДокумент
	Тогда

        ОтчетПоДокументам.ВсегоФайлов = ОтчетПоДокументам.ВсегоФайлов
            + ВсеФайлыДляДокумента.Количество();

        Для Каждого ПутьФайла Из ВсеФайлыДляДокумента Цикл

            СуществующийДок = НайтиСуществующийДокумент(
                ДанныеСтруктуры.ВидДокумента, Проект, Организация, ПутьФайла);

            Если СуществующийДок <> Неопределено Тогда
                ОтчетПоДокументам.СуществующиеДокументы.Добавить(СуществующийДок);
                СсылкаНаДокумент = СуществующийДок;
		    	//+Шерер
				ОтносительныйПутьКФайлу = ПутьФайла;
				ИмяФайлаСРасширением = Сред(ПутьФайла,СтрНайти(ПутьФайла,"\",НаправлениеПоиска.СКонца)+1);
				ОтносительныйПутьКФайлу = Лев(ПутьФайла,СтрНайти(ПутьФайла,"\",НаправлениеПоиска.СКонца)-1);
				ДобавитьРезультатЗагрузкиДокумента(ОтносительныйПутьКФайлу, ИмяФайлаСРасширением, ДанныеСтруктуры.Ссылка, СуществующийДок, _РАНЕЕ_ , "");
				//-Шерер
            Иначе
                СсылкаНаДокумент = СоздатьДокументСОД(
                    ДанныеСтруктуры.ВидДокумента,
                    Проект, Организация, КонтрагентДляЗагрузки,
                    ПутьФайла,
                    ОтчетПоДокументам,
                    ОбработанныеПапки,
                    Истина,
                    ДанныеСтруктуры.Ссылка);
            КонецЕсли;
			
			Если СсылкаНаДокумент <> Неопределено Тогда
                РезультатПрикрепления = Новый Структура(
                    "Загружено, НеЗагружено, Существовало", 0, 0, 0);
				//ПрикрепитьФайлКДокументу(
				//    ПутьФайла, СсылкаНаДокумент,
				//    ОтчетПоДокументам, РезультатПрикрепления);
				 ДанныеФайла = Новый Структура("СсылкаНаДокумент, ИмяПапки", СсылкаНаДокумент, "");
   				 ОтчетПоДокументам.ФайлыДляПрикрепления.Вставить(ПутьФайла, ДанныеФайла);

				//ОтчетПоДокументам.ФайлыДляПрикрепления.Вставить(ПутьФайла, СсылкаНаДокумент);
				//ОтчетПоДокументам.ВсегоФайлов = ОтчетПоДокументам.ВсегоФайлов + 1;
				//ОтчетПоДокументам.ФайловЗагружено = ОтчетПоДокументам.ФайловЗагружено
				//    + РезультатПрикрепления.Загружено;
				//ОтчетПоДокументам.ФайловПропущено = ОтчетПоДокументам.ФайловПропущено
				//    + РезультатПрикрепления.НеЗагружено;
				//ОтчетПоДокументам.ФайловСуществовало = ОтчетПоДокументам.ФайловСуществовало
					//+ РезультатПрикрепления.Существовало;
			Иначе
				ОтчетПоДокументам.ОшибкиФайлов.Добавить("Не загружен (документ не создан): " + ПутьФайла);	
			    ОтчетПоДокументам.ФайловПропущено = ОтчетПоДокументам.ФайловПропущено + 1;

				//+Шерер
				ОтносительныйПутьКФайлу = ПутьФайла;
				ИмяФайлаСРасширением = Сред(ПутьФайла,СтрНайти(ПутьФайла,"\",НаправлениеПоиска.СКонца)+1);
				ОтносительныйПутьКФайлу = Лев(ПутьФайла,СтрНайти(ПутьФайла,"\",НаправлениеПоиска.СКонца)-1);
				ДобавитьРезультатЗагрузкиДокумента(ОтносительныйПутьКФайлу, ИмяФайлаСРасширением, ДанныеСтруктуры.Ссылка, СуществующийДок, _БЕДА_ , "Документ не создан");
				//-Шерер
            КонецЕсли;

        КонецЦикла;

    КонецЕсли;
	#КонецОбласти

    Возврат ОтчетПоДокументам;
		
КонецФункции

// Обработчик команды прерывания загрузки.
// Устанавливает флаг остановки процесса и обновляет интерфейс.
//
// Параметры:
//  Команда - КомандаФормы - команда формы, вызвавшая событие.
//
&НаКлиенте
Процедура ЗавершитьЗагрузку(Команда)
	
	ОстановитьЗагрузку = Истина;
    ТекстСостояние = "Остановка после текущей папки...";
    ОбновитьОтображениеДанных();
	
КонецПроцедуры

// Завершает процесс загрузки, формирует и показывает пользователю итоговый табличный документ
// со статистикой и ошибками.
//
// Параметры:
//  ОтчетОбщий - Структура - общая структура со статистикой по всем обработанным папкам.
//
&НаКлиенте
Процедура ВывестиИтоговыйОтчет(ОтчетОбщий)
	
    ТекстСостояние = "Загрузка завершена.";
    ОбновитьОтображениеДанных();
    ОтчетТабДок = СформироватьОтчёт(ОтчетОбщий);
	//+Шерер убрал отображение отчета о загрузке в отдельное окно
	//Если ОтчетТабДок <> Неопределено Тогда
	//    ОтчетТабДок.ТолькоПросмотр = Истина; 
	//    ОтчетТабДок.Показать("Отчёт о загрузке документов");
	//КонецЕсли;
 	//-Шерер убрал отображение отчета о загрузке в отдельное окно
   Сообщить("Загрузка завершена.");
	
КонецПроцедуры

// Выполняет поиск ранее загруженного файла в справочнике "Файлы" по владельцу
// и пути к файлу, сохраненному в дополнительном реквизите.
//
// Параметры:
//  СсылкаНаДокумент - СправочникСсылка.ДокументыПредприятия - документ-владелец файла;
//  ПутьФайла - Строка - путь к файлу, сохраненный в доп. реквизите "ЗагруженАвтоматически".
//
// Возвращаемое значение:
//  СправочникСсылка.Файлы, Неопределено - ссылка на найденный файл или Неопределено, если файл не найден.
//
&НаСервере
Функция НайтиСуществующийФайл(СсылкаНаДокумент, ПутьФайла)
    
    Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения
        .НайтиПоРеквизиту("Имя", "ЗагруженАвтоматически");
    Если НЕ ЗначениеЗаполнено(Свойство) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |    Файлы.Ссылка
        |ИЗ
        |    Справочник.Файлы КАК Файлы
        |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ
        |            Справочник.Файлы.ДополнительныеРеквизиты КАК ДР
        |        ПО  ДР.Ссылка   = Файлы.Ссылка
        |        И   ДР.Свойство = &Свойство
        |        И   ВЫРАЗИТЬ(ДР.Значение КАК Строка(1000)) = &Путь
        |ГДЕ
        |    Файлы.ВладелецФайла = &Владелец
        |    И НЕ Файлы.ПометкаУдаления";
    Запрос.УстановитьПараметр("Свойство", Свойство);
    Запрос.УстановитьПараметр("Путь",     ПутьФайла);
    Запрос.УстановитьПараметр("Владелец", СсылкаНаДокумент);
	
	Результат = Запрос.Выполнить();
    Если Результат.Пустой() Тогда
        Возврат Неопределено;
    КонецЕсли;
    Выборка = Результат.Выбрать();
    Выборка.Следующий();
    Возврат Выборка.Ссылка;

КонецФункции 

// Собирает файлы из каталога и его подкаталогов (рекурсивно),
// для каждого файла определяя имя ПОДПАПКИ ПЕРВОГО УРОВНЯ.
// Это имя используется далее как "Роль файла" при прикреплении к документу.
// Результат функции далее используется
//
// Параметры:
//  ПутьКаталога - Строка - путь к каталогу для обхода.
//
// Возвращаемое значение:
//  Массив - массив структур, содержащих путь к файлу и имя вложенной папки.
//
&НаКлиенте
Функция СобратьФайлыПервогоУровняСГруппами(ПутьКаталога)
   
    Результат = Новый Массив;
    ЭлементыФС = НайтиФайлы(ПутьКаталога, "*", Ложь);

    Для Каждого Элемент Из ЭлементыФС Цикл
        Если Элемент.ЭтоКаталог() Тогда
		// Подпапка первого уровня и её содержимое (рекурсивно)
			//+Шерер настроил обработку вложенности подпапок
			// закомнтировал код не учитывающий вложенность подпапок
			//ВложенныеЭлементы = НайтиФайлы(Элемент.ПолноеИмя, "*", Ложь);
			//Для Каждого ВложЭлемент Из ВложенныеЭлементы Цикл
			//    Если НЕ ВложЭлемент.ЭтоКаталог() Тогда
			//        ОписаниеФайла = Новый Структура("ПутьФайла, ИмяВложеннойПапки",
			//            ВложЭлемент.ПолноеИмя, Элемент.Имя);
			//        Результат.Добавить(ОписаниеФайла);
			//    КонецЕсли;
			//КонецЦикла;
			СобратьФайлыВПодпапкеРекурсивно(
				Элемент.ПолноеИмя,
				Элемент.Имя,
				Результат);
 			//-Шерер настроил обработку вложенности подпапок
		ИначеЕсли ЭтоФайлСОД(Элемент) Тогда
 		// Файлы в корневой папке — без роли
           ОписаниеФайла = Новый Структура("ПутьФайла, ИмяВложеннойПапки",
                Элемент.ПолноеИмя, "");
            Результат.Добавить(ОписаниеФайла);
		Иначе
			// это файл не СОД, его не нужно загружать
        КонецЕсли;
    КонецЦикла;

    Возврат Результат;
КонецФункции

// Вспомогательная рекурсивная процедура: обходит подпапку первого уровня
// и все её вложенные подпапки, присваивая всем файлам роль = имя подпапки 1-го уровня.
//
&НаКлиенте
Процедура СобратьФайлыВПодпапкеРекурсивно(ПутьКаталога, ИмяПодпапкиПервогоУровня, Результат)
	
	ЭлементыФС = НайтиФайлы(ПутьКаталога, "*", Ложь);
	Для Каждого Элемент Из ЭлементыФС Цикл
		Если Элемент.ЭтоКаталог() Тогда
			// Рекурсивно спускаемся, СОХРАНЯЯ имя подпапки 1-го уровня
			СобратьФайлыВПодпапкеРекурсивно(
				Элемент.ПолноеИмя,
				ИмяПодпапкиПервогоУровня,
				Результат);
		ИначеЕсли ЭтоФайлСОД(Элемент) Тогда
			ОписаниеФайла = Новый Структура("ПутьФайла, ИмяВложеннойПапки",
				Элемент.ПолноеИмя,
				ИмяПодпапкиПервогоУровня);
			Результат.Добавить(ОписаниеФайла);
		Иначе
			// это файл не СОД, его не нужно загружать
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


// Определяет, является ли элемент файловой системы, пригодным для загрузки в СОД.
// Критерии:
//   1. Элемент является файлом (не каталогом);
//   2. Файл НЕ имеет атрибутов "Скрытый" или "Системный";
//   3. Имя файла НЕ входит в список известных служебных файлов ОС.
//
// Параметры:
//   ЭлементФС - Файл - объект файловой системы, полученный через НайтиФайлы().
//
// Возвращаемое значение:
//   Булево - Истина, если файл должен быть загружен; Ложь — если это каталог
//            или служебный файл, который нужно пропустить.
//
&НаКлиенте
Функция ЭтоФайлСОД(ЭлементФС)
	
	// 1. Должен быть именно файлом, а не каталогом
	Если ЭлементФС.ЭтоКаталог() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// 2. Проверка атрибутов (скрытый / системный)
	Попытка
		Если ЭлементФС.АтрибутыСкрытый() ИЛИ ЭлементФС.АтрибутыСистемный() Тогда
			Возврат Ложь;
		КонецЕсли;
	Исключение
		// Если не удалось получить атрибуты — не исключаем файл
	КонецПопытки;
	
	// 3. Чёрный список известных служебных файлов ОС
	ИмяФайлаНРег = НРег(ЭлементФС.Имя);
	СлужебныеИмена = Новый Массив;
	СлужебныеИмена.Добавить("desktop.ini");
	СлужебныеИмена.Добавить("thumbs.db");
	СлужебныеИмена.Добавить(".ds_store");
	СлужебныеИмена.Добавить("picasa.ini");
	
	Для Каждого СлужИмя Из СлужебныеИмена Цикл
		Если ИмяФайлаНРег = СлужИмя Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

#Область Заполнение_ТЧ_и_статистики

&НаСервере
Процедура ДобавитьРезультатЗагрузкиДокумента(Знач ПутьНаДиске, Знач ИмяФайла, Знач ПравилоЗагрузки, Знач Документ, Знач УспехРанееБеда, Знач ТекстОшибки)
	СтрокаТЧ = Объект.РезультатыЗагрузкиДокументов.Добавить();
	СтрокаТЧ.ПутьНаДиске = Сред(ПутьНаДиске,СтрДлина(Объект.КаталогПроекта)+1);
	СтрокаТЧ.ИмяФайла = ИмяФайла;
	СтрокаТЧ.ПравилоЗагрузки = ПравилоЗагрузки;
	СтрокаТЧ.Документ = Документ;
	СтрокаТЧ.ТекстОшибки = ТекстОшибки;
	Если УспехРанееБеда = _УСПЕХ_ Тогда
		СтрокаТЧ.Удача = 1;
	ИначеЕсли УспехРанееБеда = _РАНЕЕ_ Тогда
		СтрокаТЧ.ЗагруженРанее = 1;
	Иначе
		СтрокаТЧ.Беда = 1;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДобавитьРезультатЗагрузкиФайла(Знач ПутьНаДиске, Знач ИмяФайла, Знач ПравилоЗагрузки, Знач Файл, Знач УспехРанееБеда, Знач ТекстОшибки)
	Для Каждого стрРезультата ИЗ Объект.РезультатыЗагрузкиФайлов Цикл
		Если стрРезультата.ПутьНаДиске = ПутьНаДиске
		   И стрРезультата.ИмяФайла = ИмяФайла
		   И стрРезультата.ПравилоЗагрузки = ПравилоЗагрузки
		   И стрРезультата.Файл = Файл
		Тогда 
		    Возврат; //Уже добавлено
		КонецЕсли;
	КонецЦикла;
	
	СтрокаТЧ = Объект.РезультатыЗагрузкиФайлов.Добавить();
	СтрокаТЧ.ПутьНаДиске = Сред(ПутьНаДиске,СтрДлина(Объект.КаталогПроекта)+2);
	СтрокаТЧ.ИмяФайла = ИмяФайла;
	СтрокаТЧ.ПравилоЗагрузки = ПравилоЗагрузки;
	СтрокаТЧ.Файл = Файл;
	СтрокаТЧ.ТекстОшибки = ТекстОшибки;
	Если УспехРанееБеда = _УСПЕХ_ Тогда
		СтрокаТЧ.Удача = 1;
	ИначеЕсли УспехРанееБеда = _РАНЕЕ_ Тогда
		СтрокаТЧ.ЗагруженРанее = 1;
	Иначе
		СтрокаТЧ.Беда = 1;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Добавить_ТЧ_ФайлыВсего(Знач ПутьНаДиске, Знач ИмяФайла)
	Для Каждого стрРезультата ИЗ Объект.ФайлыВсего Цикл
		Если стрРезультата.ПутьНаДиске = ПутьНаДиске
		   И стрРезультата.ИмяФайла = ИмяФайла
		Тогда 
		    Возврат; //Уже добавлено
		КонецЕсли;
	КонецЦикла;
	
	СтрокаТЧ = Объект.ФайлыВсего.Добавить();
	СтрокаТЧ.ПутьНаДиске = Сред(ПутьНаДиске,СтрДлина(Объект.КаталогПроекта)+2);
	СтрокаТЧ.ИмяФайла = ИмяФайла;
КонецПроцедуры

#КонецОбласти
